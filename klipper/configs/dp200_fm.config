# Klipper build config: Sindoh DP200 UPC FM core (steppers, endstops)
# Use: cp dp200_fm.config ~/klipper/.config && make olddefconfig && make
CONFIG_MACH_UPC=y
CONFIG_UPC_CORE_FM=y
# Timer: XENA Timer1, ~395.8 MHz (measured with the probe firmware)
CONFIG_CLOCK_FREQ=396000000
CONFIG_UPC_TIMER_ADDR=0x08001144
CONFIG_UPC_THUMB=y
CONFIG_UPC_STEP_HALF_TICKS=400
# Trim optional features to fit the 16 KiB ITCM
CONFIG_WANT_HARD_PWM=y
# buttons: needed by filament_switch_sensor (xena46 lever) and
# filament_motion_sensor (dsens7 encoder). FM image 15432 B with it.
CONFIG_WANT_BUTTONS=y
# CONFIG_WANT_TMCUART is not set
# CONFIG_WANT_NEOPIXEL is not set
# CONFIG_WANT_PULSE_COUNTER is not set
# CONFIG_WANT_ST7920 is not set
# CONFIG_WANT_HD44780 is not set
# CONFIG_WANT_HX71X is not set
# CONFIG_WANT_CS1237 is not set
