From 10f6c6e0187acd4a08d471b9fe2d3f63e46c9a3f Mon Sep 17 00:00:00 2001
From: catawalks <59056948+catawalks@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:23:21 -0400
Subject: [PATCH 13/14] sindoh-dp200: filament dryer macros (FILAMENT_DRY)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 config/sindoh-dp200/dp200_macros.cfg  | 123 ++++++++++++++++++++++++++
 config/sindoh-dp200/dp200_printer.cfg |   1 +
 2 files changed, 124 insertions(+)

diff --git a/config/sindoh-dp200/dp200_macros.cfg b/config/sindoh-dp200/dp200_macros.cfg
index d87d1ea4..dc5e1305 100644
--- a/config/sindoh-dp200/dp200_macros.cfg
+++ b/config/sindoh-dp200/dp200_macros.cfg
@@ -565,3 +565,126 @@ gcode:
     Z_OFFSET_APPLY_PROBE
     SET_GCODE_OFFSET Z=0
     M118 Run SAVE_CONFIG to store z_offset={new}
+
+# ---------------------------------------------------------------------
+# Filament dryer: a spool lying flat on the heated bed, doors closed.
+#   FILAMENT_DRY TEMP=50 HOURS=4 [MATERIAL=PLA] [FORCE=1]
+#   FILAMENT_DRY_STOP
+# Lowers the bed, brings it forward, parks the head off the bed, heats the
+# bed for HOURS, vents the case now and then, reminds to flip the spool
+# halfway and signals the end (lamp flashes + M118; beeper once configured).
+# Build sheets have a continuous limit (the test printer's: 70 C): above
+# variable_sheet_max it needs FORCE=1. The touch screen asks first.
+# ---------------------------------------------------------------------
+[gcode_macro _DRY]
+variable_active: 0
+variable_remaining: 0         # minutes left
+variable_total: 0             # minutes
+variable_temp: 0
+variable_flipped: 0
+variable_sheet_max: 70        # build sheet's continuous rating (C)
+variable_vent_every: 15       # minutes between vents (exhaust fan 1 min)
+gcode:
+
+[gcode_macro FILAMENT_DRY]
+description: Dry a spool on the bed. TEMP= (C) HOURS= [MATERIAL=] [FORCE=1 above the sheet limit]
+gcode:
+    {% set d = printer["gcode_macro _DRY"] %}
+    {% set temp = params.TEMP|default(50)|float %}
+    {% set hours = params.HOURS|default(4)|float %}
+    {% set limit = printer.configfile.settings.heater_bed.max_temp|float %}
+    {% if printer.print_stats.state in ('printing', 'paused') %}
+        {action_raise_error("FILAMENT_DRY: a print is running")}
+    {% elif temp < 35 or temp > limit %}
+        {action_raise_error("FILAMENT_DRY: TEMP must be 35..%d C" % limit)}
+    {% elif temp > d.sheet_max and params.FORCE|default(0)|int != 1 %}
+        {action_raise_error("FILAMENT_DRY: %d C is above the build sheet's %d C limit - add FORCE=1 if your sheet is rated for it" % (temp, d.sheet_max))}
+    {% elif hours <= 0 or hours > 24 %}
+        {action_raise_error("FILAMENT_DRY: HOURS must be 0..24")}
+    {% endif %}
+    {% set c = printer["gcode_macro _DP200"] %}
+    {% set th = printer.toolhead %}
+    M104 S0
+    _SINDOH_ENSURE_HOMED
+    G90
+    G1 Z{th.axis_maximum.z - 4} F600            # bed down: room for a spool lying flat
+    G1 X{c.park_x} Y{th.axis_maximum.y} F6000   # head off the bed, bed forward to the door
+    {% set mins = (hours * 60)|int %}
+    SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=active VALUE=1
+    SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=remaining VALUE={mins}
+    SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=total VALUE={mins}
+    SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=temp VALUE={temp}
+    SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=flipped VALUE=0
+    # idle_timeout would turn the bed off after 10 min without G-code
+    SET_IDLE_TIMEOUT TIMEOUT={mins * 60 + 900}
+    M140 S{temp}
+    UPDATE_DELAYED_GCODE ID=_DRY_TICK DURATION=60
+    M118 Drying {params.MATERIAL|default('filament')}: bed {temp|int} C for {hours} h. Put the spool on the bed lying flat and close the doors.
+
+[delayed_gcode _DRY_TICK]
+gcode:
+    {% set d = printer["gcode_macro _DRY"] %}
+    {% if d.active %}
+        {% set left = d.remaining - 1 %}
+        SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=remaining VALUE={left}
+        {% if left <= 0 %}
+            _DRY_DONE
+        {% else %}
+            M140 S{d.temp}                     # in case something turned it off
+            {% if (d.total - left) % d.vent_every == 0 %}
+                SET_FAN_SPEED FAN=exhaust_fan SPEED=0.6
+            {% else %}
+                SET_FAN_SPEED FAN=exhaust_fan SPEED=0
+            {% endif %}
+            {% if not d.flipped and left <= d.total // 2 %}
+                SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=flipped VALUE=1
+                M118 Drying: halfway - flip the spool over for even drying
+                _DRY_SIGNAL N=2
+            {% endif %}
+            UPDATE_DELAYED_GCODE ID=_DRY_TICK DURATION=60
+        {% endif %}
+    {% endif %}
+
+[gcode_macro _DRY_DONE]
+gcode:
+    _DRY_OFF
+    M118 Drying finished - take the spool out (the bed is still warm)
+    _DRY_SIGNAL N=5
+
+[gcode_macro FILAMENT_DRY_STOP]
+description: Stop the filament dryer (bed off)
+gcode:
+    {% if printer["gcode_macro _DRY"].active %}
+        _DRY_OFF
+        M118 Drying stopped
+    {% endif %}
+
+[gcode_macro _DRY_OFF]
+gcode:
+    {% set idle = printer.configfile.settings.idle_timeout %}
+    UPDATE_DELAYED_GCODE ID=_DRY_TICK DURATION=0
+    SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=active VALUE=0
+    SET_GCODE_VARIABLE MACRO=_DRY VARIABLE=remaining VALUE=0
+    M140 S0
+    SET_FAN_SPEED FAN=exhaust_fan SPEED=0
+    SET_IDLE_TIMEOUT TIMEOUT={idle.timeout if idle is defined else 600}
+
+# Lamp flashes N times, plus the beeper when [output_pin beeper] exists
+# (dec_pwm block 10; not configured until it has been tested).
+[gcode_macro _DRY_SIGNAL]
+gcode:
+    {% set lamp = printer["output_pin lamp"].value %}
+    {% set beep = 'output_pin beeper' in printer %}
+    {% for i in range(params.N|default(3)|int) %}
+        SET_PIN PIN=lamp VALUE=0
+        {% if beep %}
+            SET_PIN PIN=beeper VALUE=0.5
+        {% endif %}
+        G4 P400
+        SET_PIN PIN=lamp VALUE=1
+        {% if beep %}
+            SET_PIN PIN=beeper VALUE=0
+        {% endif %}
+        G4 P400
+    {% endfor %}
+    SET_PIN PIN=lamp VALUE={lamp}
diff --git a/config/sindoh-dp200/dp200_printer.cfg b/config/sindoh-dp200/dp200_printer.cfg
index 23317cb5..0419c8ab 100644
--- a/config/sindoh-dp200/dp200_printer.cfg
+++ b/config/sindoh-dp200/dp200_printer.cfg
@@ -414,6 +414,7 @@ gcode:
     {% set ext = params.EXTRUDER|default(210)|float %}
     {% set n = params.MESH|default(4)|int %}
     CLEAR_PAUSE
+    FILAMENT_DRY_STOP          # a print ends a running filament dryer
     M140 S{bed}
     M104 S150                  # warm the nozzle without oozing while probing
     G28
-- 
