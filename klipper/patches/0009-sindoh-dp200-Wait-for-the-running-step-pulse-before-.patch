From 2e5addc5acd7ff377fbcd0aa2098962134be71f8 Mon Sep 17 00:00:00 2001
From: catawalks <59056948+catawalks@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:02:53 -0400
Subject: [PATCH 9/9] sindoh-dp200: Wait for the running step pulse before
 changing direction

Klipper changes direction ~2 us after the last step started, while that
4 us engine pulse was still running; rewriting CTRL (0x44) mid-pulse lost
~0.2 step per back-and-forth cycle on X and Y. The first test box leaned
~1 mm per 10 mm of height. smot_set_dir now waits for the engine to be
idle first, like the stock app, and counts these waits (dir_waits in
UPC_STEP_STATS).

Drift test (endstop trigger before/after 100 cycles of 20 mm at 30,
100 and 10 mm/s): X/Y +0.20..0.24 mm before, 0.000 mm after;
dir_waits X 574, Y 571.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 klippy/extras/upc_stats.py | 11 +++++++----
 src/upc/gpio.c             | 36 +++++++++++++++++++++++++++---------
 2 files changed, 34 insertions(+), 13 deletions(-)

diff --git a/klippy/extras/upc_stats.py b/klippy/extras/upc_stats.py
index f9349e51..d01abfc1 100644
--- a/klippy/extras/upc_stats.py
+++ b/klippy/extras/upc_stats.py
@@ -1,5 +1,6 @@
 # DP200 / UPC port diagnostics: report the step-engine counters of the FM
-# MCU (pulses issued, pulses requested while the engine was still busy).
+# MCU (pulses issued, pulses requested while the engine was still busy,
+# direction changes that had to wait for a running pulse).
 #
 # Install: copy to ~/klipper/klippy/extras/, add [upc_stats] to printer.cfg.
 # G-code: UPC_STEP_STATS
@@ -21,7 +22,8 @@ class UpcStats:
     def _build_config(self):
         self.query = self.mcu.lookup_query_command(
             "upc_step_stats engine=%c",
-            "upc_step_stats_result engine=%c pulses=%u busy_hits=%u")
+            "upc_step_stats_result engine=%c pulses=%u busy_hits=%u"
+            " dir_waits=%u")
     cmd_UPC_STEP_STATS_help = "Report UPC step-engine pulse / busy-hit counters"
     def cmd_UPC_STEP_STATS(self, gcmd):
         if self.query is None:
@@ -29,8 +31,9 @@ class UpcStats:
         lines = []
         for name, n in ENGINES:
             r = self.query.send([n])
-            lines.append("%s (engine %d): pulses=%d busy_hits=%d"
-                         % (name, n, r['pulses'], r['busy_hits']))
+            lines.append("%s (engine %d): pulses=%d busy_hits=%d dir_waits=%d"
+                         % (name, n, r['pulses'], r['busy_hits'],
+                            r['dir_waits']))
         gcmd.respond_info("\n".join(lines))
 
 def load_config(config):
diff --git a/src/upc/gpio.c b/src/upc/gpio.c
index 5b54953d..644cf666 100644
--- a/src/upc/gpio.c
+++ b/src/upc/gpio.c
@@ -168,19 +168,29 @@ smot_claim(uint8_t n)
 // reports busy (+0x64 bit 8); in that case wait for the running pulse (a
 // few us) instead of overwriting it. upc_step_stats reports the counters.
 static uint32_t smot_pulses[SMOT_COUNT], smot_busy_hits[SMOT_COUNT];
+static uint32_t smot_dir_waits[SMOT_COUNT];
+
+// Wait (bounded) until the engine's running pulse has finished. Returns
+// nonzero if it had to wait.
+static inline int
+smot_wait_idle(uint32_t b)
+{
+    if (!(reg_read(b + SMOT_STATUS) & SMOT_DONE_BIT))
+        return 0;
+    // one pulse is 2 edges of CONFIG_UPC_STEP_HALF_TICKS: bound the wait
+    for (uint32_t i = 0; i < 4096; i++)
+        if (!(reg_read(b + SMOT_STATUS) & SMOT_DONE_BIT))
+            break;
+    return 1;
+}
 
 static inline void
 smot_pulse(uint8_t n)
 {
     uint32_t b = SMOT_BASE(n);
     smot_pulses[n]++;
-    if (reg_read(b + SMOT_STATUS) & SMOT_DONE_BIT) {
+    if (smot_wait_idle(b))
         smot_busy_hits[n]++;
-        // one pulse is 2 edges of CONFIG_UPC_STEP_HALF_TICKS: bound the wait
-        for (uint32_t i = 0; i < 4096; i++)
-            if (!(reg_read(b + SMOT_STATUS) & SMOT_DONE_BIT))
-                break;
-    }
     reg_write(b + SMOT_CLEAR, SMOT_DONE_BIT);
     reg_write(b + SMOT_CMD, (2u << 16) | SMOT_MODE_CONST);
     reg_write(b + SMOT_START, 1);
@@ -194,7 +204,8 @@ command_upc_step_stats(uint32_t *args)
     if (n >= SMOT_COUNT)
         shutdown("Invalid engine");
     sendf("upc_step_stats_result engine=%c pulses=%u busy_hits=%u"
-          , n, smot_pulses[n], smot_busy_hits[n]);
+          " dir_waits=%u"
+          , n, smot_pulses[n], smot_busy_hits[n], smot_dir_waits[n]);
 }
 DECL_COMMAND(command_upc_step_stats, "upc_step_stats engine=%c");
 #endif
@@ -202,9 +213,16 @@ DECL_COMMAND(command_upc_step_stats, "upc_step_stats engine=%c");
 static void
 smot_set_dir(uint8_t n, uint8_t val)
 {
+    // Klipper changes direction ~2 us after the last step started, while
+    // that 4 us engine pulse is still running. The stock app only writes
+    // CTRL to an idle engine; doing it mid-pulse lost ~0.2 step per
+    // back-and-forth cycle on X/Y (2026-10-27 drift test). Klipper's dir
+    // setup time before the next step starts after this returns.
+    uint32_t b = SMOT_BASE(n);
+    if (smot_wait_idle(b))
+        smot_dir_waits[n]++;
     dir_level[n] = !!val;
-    reg_write(SMOT_BASE(n) + SMOT_CTRL
-              , SMOT_CTRL_STOCK | (val ? SMOT_CTRL_DIR : 0));
+    reg_write(b + SMOT_CTRL, SMOT_CTRL_STOCK | (val ? SMOT_CTRL_DIR : 0));
 }
 
 static void
