# GNU tar --exclude-from list: parts of the SD build root that a Klipper
# RUNTIME image on internal NAND does not need (paths relative to the root,
# as given to tar: ./usr/...). Build tools, docs, caches, MCU SDKs.
./usr/lib/gcc
./usr/libexec/gcc
./usr/lib/arm-none-eabi
./usr/lib/gcc-cross
./usr/share/gcc
./usr/share/gdb
./usr/include
./usr/share/doc
./usr/share/man
./usr/share/info
./usr/share/locale
./usr/share/lintian
./usr/share/bash-completion
./usr/bin/arm-none-eabi-*
./usr/bin/arm-linux-gnueabi-*
./usr/bin/*-gcc*
./usr/bin/*-g++*
./usr/bin/gcc*
./usr/bin/g++*
./usr/bin/cpp*
./usr/bin/c++*
./usr/bin/lto-dump*
./usr/lib/arm-linux-gnueabi/*.a
./usr/lib/python3*/test
./usr/lib/python3*/idlelib
./usr/lib/python3*/ensurepip
./usr/lib/python3*/config-*
./usr/src
./var/cache
./var/lib/apt/lists
./var/log
./root/.cache
./home/klipper/.cache
./home/klipper/klipper/.git
./home/klipper/klipper/lib
./home/klipper/klipper/src
./home/klipper/klipper/docs/*
./home/klipper/klipper/test
./home/klipper/klipper/out
# scratch build trees and test firmware (2026-11-03: kb_out got packed)
./home/klipper/kb
./home/klipper/kb_out
./opt/dp200/fm_*.bin
./opt/dp200/io_*.bin
./home/klipper/moonraker/.git
./home/klipper/moonraker/docs
./home/klipper/printer_data/logs/*
./home/klipper/printer_data/database/*
./home/klipper/printer_data/gcodes/*
*/__pycache__/*.opt-*.pyc
./etc/dp200/rc.dp200.*
./opt/dp200/fm_*.bin
./opt/dp200/io_*.bin
# numpy for input shaping is opt-in (~25 MB): setup_numpy.sh reinstalls it
./usr/lib/python3/dist-packages/numpy
./usr/local/lib/dp200-numpy
./usr/lib/arm-linux-gnueabi/blas
./usr/lib/arm-linux-gnueabi/lapack
./usr/lib/arm-linux-gnueabi/libgfortran.so.5*
# Stock-root install (2026-11-02): it must fit next to the stock system in
# mtd6 (~147 MB with the Sindoh app removed), so drop more:
# this printer's recovery/test files (stock kernel image, logo backups, tools)
./var/backups
./root
# compiler leftovers the patterns above miss
./usr/bin/*lto-dump*
./usr/lib/arm-linux-gnueabi/libasan.so*
./usr/lib/arm-linux-gnueabi/libubsan.so*
./usr/lib/arm-linux-gnueabi/liblsan.so*
./usr/lib/arm-linux-gnueabi/libtsan.so*
./usr/lib/arm-linux-gnueabi/libisl.so*
./usr/lib/arm-linux-gnueabi/libmpc.so*
./usr/lib/arm-linux-gnueabi/libmpfr.so*
./usr/lib/arm-linux-gnueabi/libbfd*
./usr/lib/arm-linux-gnueabi/libopcodes*
./usr/lib/arm-linux-gnueabi/libctf*
./usr/lib/arm-linux-gnueabi/libgprofng*
# perl (only Debian's package scripts use it; perl-base stays)
./usr/lib/arm-linux-gnueabi/perl
./usr/share/perl
./usr/bin/perl5*
# git (only Moonraker's update manager; updates come from the USB stick)
./usr/lib/git-core
./usr/share/git-core
./usr/bin/git*
./usr/bin/scalar
# iconv character sets (Python and the stack don't use glibc iconv)
./usr/lib/arm-linux-gnueabi/gconv
# pip/setuptools inside the venvs (nothing is installed on the printer)
./home/klipper/klippy-env/lib/python3*/site-packages/pip
./home/klipper/klippy-env/lib/python3*/site-packages/setuptools
./home/klipper/moonraker-env/lib/python3*/site-packages/pip
./home/klipper/moonraker-env/lib/python3*/site-packages/setuptools
./usr/share/python-wheels
./var/lib/dpkg/info/*.md5sums
# the perl binary, apt and debugging tools (no package installs on the printer)
./usr/bin/perl
./usr/lib/arm-linux-gnueabi/libperl.so*
./usr/bin/apt*
./usr/bin/sqv
./usr/lib/apt
./usr/lib/arm-linux-gnueabi/libapt-*
./var/lib/apt
./usr/bin/strace
./home/klipper/klipper/scripts/*.ipynb
*/site-packages/*/*.c
*/site-packages/*/*.pyx
# this printer's entropy seed (dp200-entropy.py): never shipped
./var/lib/dp200/random-seed
