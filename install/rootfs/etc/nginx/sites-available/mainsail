# Mainsail on port 80, proxying Moonraker (127.0.0.1:7125) and the webcam
# (ustreamer on 127.0.0.1:8080, started by rc.dp200).

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream moonraker {
    server 127.0.0.1:7125;
}

server {
    listen 80 default_server;
    root /home/klipper/mainsail;
    index index.html;
    server_name _;
    client_max_body_size 0;
    # No per-request log: Mainsail polls the webcam snapshot about once per
    # second, which filled the 4 GB card with a 600 MB access.log (no
    # logrotate/cron in the chroot). Errors still go to error.log.
    access_log off;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location /websocket {
        proxy_pass http://moonraker/websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location ~ ^/(printer|api|access|machine|server)/ {
        proxy_pass http://moonraker$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Scheme $scheme;
    }

    location /webcam/ {
        proxy_pass http://127.0.0.1:8080/;
        # pass frames straight through: no temp files on the card (a full
        # card truncated every snapshot) and lower stream latency
        proxy_buffering off;
    }
}
