+/*
+ * Debug switches for the hang hunt, both 0644 so one image covers an A/B
+ * run without a reboot (the command line is forced):
+ * - pcs_ms: the sampler period in ms (10 by default; without
+ *   HIGH_RES_TIMERS it fires from the HZ=100 tick, so it rounds up to
+ *   10 ms steps). 0 stops it on both CPUs; a value > 0 restarts it.
+ * - pcs_mb: the barrier before each sample's seq write. 2 (default, as
+ *   patch 0017's writel()): wmb(), i.e. dsb(st) plus soc_mb, the DDR
+ *   controller write-buffer drain; 1: dsb(st) only; 0: none. Without the
+ *   sampler an idle CPU hardly ever drains (the tick path is all
+ *   _relaxed), with it both CPUs drain every 10 ms.
+ * - idle_poll: 1 makes idle CPUs spin in cpu_idle_poll() instead of
+ *   entering WFI (what "nohlt" does at boot); 0 brings WFI back.
+ */
+static int bs_ms_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_uint(val, kp);
+
+	if (!ret && READ_ONCE(bs_ready))
+		on_each_cpu(bs_kick, NULL, 1);
+	return ret;
