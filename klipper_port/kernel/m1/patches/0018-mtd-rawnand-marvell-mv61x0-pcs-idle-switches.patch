+	int ret = param_set_bool(val, kp);
+
+	/* sets are serialised by the param lock */
+	if (!ret && bs_idle_poll != old)
+		cpu_idle_poll_ctrl(bs_idle_poll);
+	return ret;
+}
+
+static const struct kernel_param_ops bs_idle_poll_ops = {
+	.set = bs_idle_poll_set,
+	.get = param_get_bool,
+};
+module_param_cb(idle_poll, &bs_idle_poll_ops, &bs_idle_poll, 0644);
+MODULE_PARM_DESC(idle_poll, "debug: 1 = idle CPUs poll instead of WFI (like nohlt)");
