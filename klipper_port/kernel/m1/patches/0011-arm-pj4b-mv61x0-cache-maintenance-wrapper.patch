From: catawalks <59056948+catawalks@users.noreply.github.com>
Subject: [PATCH] ARM: PJ4B 88PA61x0: vendor wrapper around D-cache maintenance

Test options for the DP200 nandboot hangs, off by default
(docs/kernel/nandboot_hang_analysis.md).
---
--- a/arch/arm/mm/Kconfig
+++ b/arch/arm/mm/Kconfig
@@ -373,6 +373,25 @@
 	bool
 	select CPU_V7
 
+config PJ4B_MV61X0_CACHE_WRAP
+	bool "88PA61x0 PJ4B-MP: IRQs off, dsb and a delay around D-cache maintenance"
+	depends on CPU_PJ4B && ARCH_MV61X0
+	help
+	  The Marvell 3.2 vendor kernel of the 88PA6170 runs every D-cache
+	  maintenance routine (by MVA and by set/way) with IRQs disabled,
+	  after a dsb and a 50-iteration delay loop. The erratum behind it
+	  is not documented. Test option (docs/kernel/nandboot_hang_analysis.md).
+
+config PJ4B_ERRATA_6011
+	bool "88PA61x0 PJ4B-MP erratum 6011: five LDREX, IRQs off"
+	depends on CPU_PJ4B && ARCH_MV61X0
+	help
+	  As the Marvell 3.2 vendor kernel of the 88PA6170: every exclusive
+	  load is issued five times. Kernel atomics, cmpxchg, locks and bitops
+	  mask IRQs for the five loads only, not up to the store. Futex, SWP
+	  emulation and the kuser cmpxchg helpers get the five loads only.
+	  Part of the two-CPU fix (docs/kernel/smp_freeze_summary.md).
+
 # ARMv6
 config CPU_V6
 	bool
--- a/arch/arm/mm/cache-v7.S
+++ b/arch/arm/mm/cache-v7.S
@@ -19,6 +19,29 @@
 
 .arch armv7-a
 
+/*
+ * 88PA61x0 PJ4B-MP (CONFIG_PJ4B_MV61X0_CACHE_WRAP): as the vendor 3.2
+ * kernel, D-cache maintenance runs with IRQs off, after a dsb and a
+ * 50-iteration delay. \flags keeps the CPSR, \tmp is scratch.
+ */
+	.macro	pj4b_cache_enter, flags, tmp
+#ifdef CONFIG_PJ4B_MV61X0_CACHE_WRAP
+	mrs	\flags, cpsr
+	cpsid	i
+	dsb
+	mov	\tmp, #50
+.Lpj4b_delay\@:
+	subs	\tmp, \tmp, #1
+	bne	.Lpj4b_delay\@
+#endif
+	.endm
+
+	.macro	pj4b_cache_exit, flags
+#ifdef CONFIG_PJ4B_MV61X0_CACHE_WRAP
+	msr	cpsr_c, \flags
+#endif
+	.endm
+
 #ifdef CONFIG_CPU_ICACHE_MISMATCH_WORKAROUND
 .globl icache_size
 	.data
@@ -98,6 +121,7 @@
 
 ENTRY(v7_flush_dcache_louis)
 	dmb					@ ensure ordering with previous memory accesses
+	pj4b_cache_enter ip, r1
 	mrc	p15, 1, r0, c0, c0, 1		@ read clidr, r0 = clidr
 ALT_SMP(mov	r3, r0, lsr #20)		@ move LoUIS into position
 ALT_UP(	mov	r3, r0, lsr #26)		@ move LoUU into position
@@ -105,14 +129,22 @@
 	bne	start_flush_levels		@ LoU != 0, start flushing
 #ifdef CONFIG_ARM_ERRATA_643719
 ALT_SMP(mrc	p15, 0, r2, c0, c0, 0)		@ read main ID register
+#ifdef CONFIG_PJ4B_MV61X0_CACHE_WRAP
+ALT_UP(	b	finished)			@ LoUU is zero, so nothing to do
+#else
 ALT_UP(	ret	lr)				@ LoUU is zero, so nothing to do
+#endif
 	movw	r1, #:lower16:(0x410fc090 >> 4)	@ ID of ARM Cortex A9 r0p?
 	movt	r1, #:upper16:(0x410fc090 >> 4)
 	teq	r1, r2, lsr #4			@ test for errata affected core and if so...
 	moveq	r3, #1 << 1			@   fix LoUIS value
 	beq	start_flush_levels		@   start flushing cache levels
 #endif
+#ifdef CONFIG_PJ4B_MV61X0_CACHE_WRAP
+	b	finished
+#else
 	ret	lr
+#endif
 ENDPROC(v7_flush_dcache_louis)
 
 /*
@@ -126,6 +158,7 @@
  */
 ENTRY(v7_flush_dcache_all)
 	dmb					@ ensure ordering with previous memory accesses
+	pj4b_cache_enter ip, r1
 	mrc	p15, 1, r0, c0, c0, 1		@ read clidr
 	mov	r3, r0, lsr #23			@ move LoC into position
 	ands	r3, r3, #7 << 1			@ extract LoC*2 from clidr
@@ -180,6 +213,7 @@
 	mcr	p15, 2, r10, c0, c0, 0		@ select current cache level in cssr
 	dsb	st
 	isb
+	pj4b_cache_exit ip
 	ret	lr
 ENDPROC(v7_flush_dcache_all)
 
@@ -281,6 +315,26 @@
  */
 SYM_TYPED_FUNC_START(v7_coherent_user_range)
  UNWIND(.fnstart		)
+#ifdef CONFIG_PJ4B_MV61X0_CACHE_WRAP
+	pj4b_cache_enter ip, r2
+	dcache_line_size r2, r3
+	sub	r3, r2, #1
+	bic	r0, r0, r3
+1:
+ USER(	mcr	p15, 0, r0, c7, c11, 1	)	@ clean D line to the point of unification
+	dsb	ishst
+ USER(	mcr	p15, 0, r0, c7, c5, 1	)	@ invalidate I line
+	add	r0, r0, r2
+	cmp	r0, r1
+	blo	1b
+	mov	r0, #0
+	ALT_SMP(mcr	p15, 0, r0, c7, c1, 6)	@ invalidate BTB Inner Shareable
+	ALT_UP(mcr	p15, 0, r0, c7, c5, 6)	@ invalidate BTB
+	dsb	ishst
+	isb
+	pj4b_cache_exit ip
+	ret	lr
+#else
 	dcache_line_size r2, r3
 	sub	r3, r2, #1
 	bic	r12, r0, r3
@@ -313,12 +367,14 @@
 	dsb	ishst
 	isb
 	ret	lr
+#endif
 
 /*
  * Fault handling for the cache operation above. If the virtual address in r0
  * isn't mapped, fail with -EFAULT.
  */
 9001:
+	pj4b_cache_exit ip
 #ifdef CONFIG_ARM_ERRATA_775420
 	dsb
 #endif
@@ -337,6 +393,7 @@
  *	- size	- region size
  */
 SYM_TYPED_FUNC_START(v7_flush_kern_dcache_area)
+	pj4b_cache_enter ip, r3
 	dcache_line_size r2, r3
 	add	r1, r0, r1
 	sub	r3, r2, #1
@@ -351,6 +408,7 @@
 	cmp	r0, r1
 	blo	1b
 	dsb	st
+	pj4b_cache_exit ip
 	ret	lr
 SYM_FUNC_END(v7_flush_kern_dcache_area)
 
@@ -365,6 +423,7 @@
  *	- end     - virtual end address of region
  */
 v7_dma_inv_range:
+	pj4b_cache_enter ip, r3
 	dcache_line_size r2, r3
 	sub	r3, r2, #1
 	tst	r0, r3
@@ -386,6 +445,7 @@
 	cmplo	r0, r1
 	blo	1b
 	dsb	st
+	pj4b_cache_exit ip
 	ret	lr
 ENDPROC(v7_dma_inv_range)
 
@@ -395,6 +455,7 @@
  *	- end     - virtual end address of region
  */
 v7_dma_clean_range:
+	pj4b_cache_enter ip, r3
 	dcache_line_size r2, r3
 	sub	r3, r2, #1
 	bic	r0, r0, r3
@@ -408,6 +469,7 @@
 	cmp	r0, r1
 	blo	1b
 	dsb	st
+	pj4b_cache_exit ip
 	ret	lr
 ENDPROC(v7_dma_clean_range)
 
@@ -417,6 +479,7 @@
  *	- end     - virtual end address of region
  */
 SYM_TYPED_FUNC_START(v7_dma_flush_range)
+	pj4b_cache_enter ip, r3
 	dcache_line_size r2, r3
 	sub	r3, r2, #1
 	bic	r0, r0, r3
@@ -430,6 +493,7 @@
 	cmp	r0, r1
 	blo	1b
 	dsb	st
+	pj4b_cache_exit ip
 	ret	lr
 SYM_FUNC_END(v7_dma_flush_range)
 
