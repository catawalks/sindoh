--- a/drivers/net/wireless/marvell/mwifiex/Kconfig
+++ b/drivers/net/wireless/marvell/mwifiex/Kconfig
@@ -42,5 +42,16 @@
 	  This adds support for wireless adapters based on Marvell
 	  8797/8997 chipset with USB interface.
 
+config MWIFIEX_USB_8782_START
+	bool "88W8782: start the firmware the vendor driver's way"
+	depends on MWIFIEX_USB
+	help
+	  The Marvell SDK driver downloads the 88W8782 firmware without
+	  probing for a running one first, then reads the firmware's
+	  INIT_DONE event (up to 2 s) before the first command. mwifiex
+	  probes first and sleeps instead. This option does it the SDK way,
+	  with module parameters to switch each step back, and logs what the
+	  chip sends at each step. Sindoh DP200 test option.
+
 	  If you choose to build it as a module, it will be called
 	  mwifiex_usb.
--- a/drivers/net/wireless/marvell/mwifiex/usb.c
+++ b/drivers/net/wireless/marvell/mwifiex/usb.c
@@ -12,6 +12,23 @@
 
 static const struct mwifiex_if_ops usb_ops;
 
+#ifdef CONFIG_MWIFIEX_USB_8782_START
+/*
+ * 88W8782 start-up as the Marvell SDK (usb8xxx/mlan, card type USB8782)
+ * does it: no winner probe, the whole image, then a read of EP1 for the
+ * firmware's INIT_DONE event (0xBEEFFACE, cause 7, up to 2 s) before any
+ * command. docs/kernel/wifi_boot_failure.md in the DP200 port.
+ */
+static bool usb8782_winner;
+module_param(usb8782_winner, bool, 0644);
+MODULE_PARM_DESC(usb8782_winner,
+		 "8782: probe for a running firmware before the download (mainline way)");
+static uint usb8782_ready_ms = 2000;
+module_param(usb8782_ready_ms, uint, 0644);
+MODULE_PARM_DESC(usb8782_ready_ms,
+		 "8782: wait up to this many ms for INIT_DONE after the download (0: sleep 500 ms)");
+#endif
+
 static const struct usb_device_id mwifiex_usb_table[] = {
 	/* 8782 */
 	{USB_DEVICE(USB8XXX_VID, USB8782_PID)},
