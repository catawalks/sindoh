 }
 
+#ifdef CONFIG_MWIFIEX_USB_8782_START
+/*
+ * Read EP1 right after the download, as the SDK does, and log what comes:
+ * INIT_DONE, something else, or nothing. A failure here is only logged;
+ * FUNC_INIT follows either way, so the two cases can be compared.
+ */
+static void mwifiex_usb_8782_ready(struct mwifiex_adapter *adapter)
+{
+	ktime_t t0 = ktime_get();
+	u32 len = MWIFIEX_RX_CMD_BUF_SIZE;
+	u32 type, cause;
+	u8 *buf;
+	int ret;
+
+	buf = kzalloc(len, GFP_KERNEL);
+	if (!buf)
+		return;
+	ret = mwifiex_read_data_sync(adapter, buf, &len,
+				     MWIFIEX_USB_EP_CMD_EVENT,
+				     usb8782_ready_ms);
+	if (ret) {
+		mwifiex_dbg(adapter, MSG,
+			    "8782: no INIT_DONE in %u ms (%d)\n",
+			    usb8782_ready_ms, ret);
+	} else {
+		type = len >= 4 ? le32_to_cpup((__le32 *)buf) : 0;
+		cause = len >= 8 ? le32_to_cpup((__le32 *)(buf + 4)) : 0;
+		if (type == MWIFIEX_USB_TYPE_EVENT && (cause & 0xffff) == 7)
+			mwifiex_dbg(adapter, MSG,
+				    "8782: INIT_DONE after %lld ms\n",
+				    ktime_ms_delta(ktime_get(), t0));
+		else
+			mwifiex_dbg(adapter, MSG,
+				    "8782: after %lld ms, %u bytes instead of INIT_DONE: %*ph\n",
+				    ktime_ms_delta(ktime_get(), t0), len,
+				    (int)min_t(u32, len, 32), buf);
+	}
+	kfree(buf);
+}
+#endif
