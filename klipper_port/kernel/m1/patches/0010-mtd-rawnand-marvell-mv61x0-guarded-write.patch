+/*
+ * bch_v1 (88PA6170) program/erase window, in erase blocks of the chip: up
+ * to BCH_V1_WIN_MAX ranges FIRST,LAST separated by ';'. Empty by default:
+ * nothing is programmed or erased until it is set, e.g.
+ *   echo '1741,4091;2,63' > /sys/module/marvell_nand/parameters/write_window
+ * or marvell_nand.write_window=1741,4091 on the command line (the NAND-boot
+ * image: its root in mtd6 is writable from boot on). Each range must lie
+ * inside one of three fixed areas of the stock layout, or the whole setting
+ * is refused: the kernel part of mtd0 (blocks 2-63, after the 2 U-Boot
+ * blocks), the logo (mtd3, 69-76) and the root (mtd6, 1741 up to the vendor
+ * BBT: main + mirror + 2 spare blocks in the last 4 blocks of the chip,
+ * 4092-4095). U-Boot, the U-Boot env (64), the bbt partition (65-68),
+ * /backup and the factory recovery set (77-1740) and the vendor BBT are
+ * never written; every command is checked against the areas again.
+ */
+#define BCH_V1_KERNEL_FIRST	(0x40000 / SZ_128K)	/* mtd0 after U-Boot */
+#define BCH_V1_KERNEL_LAST	(0x800000 / SZ_128K - 1)
+#define BCH_V1_LOGO_FIRST	(0x8a0000 / SZ_128K)	/* mtd3 "boot-logo" */
+#define BCH_V1_LOGO_LAST	(0x9a0000 / SZ_128K - 1)
+#define BCH_V1_FIRST_WRITABLE	(0xd9a0000 / SZ_128K)	/* mtd6 "filesystem" */
+#define BCH_V1_BBT_BLOCKS	4
+#define BCH_V1_PAGES_PER_BLOCK	64
+
+/* section 9: BCH reads per page before UNCERR / no data counts as failed */
+#define BCH_V1_READ_TRIES	4
+static uint bch_v1_reread_ok;	/* more counters: stats (section 10) */
+module_param_named(reread_ok, bch_v1_reread_ok, uint, 0444);
+MODULE_PARM_DESC(reread_ok, "88PA6170: pages read correctly after a retry");
+static u32 bch_v1_last_ndsr;
+
+/* the chip's blocks once probed; before (command line), the DP200's 4 Gb */
+static int bch_v1_nblocks = 4096;
+
+/* which fixed area a block is in: 1 kernel, 2 logo, 3 root, 0 none */
+static int bch_v1_area(int block, int nblocks)
+{
+	if (block >= BCH_V1_KERNEL_FIRST && block <= BCH_V1_KERNEL_LAST)
+		return 1;
+	if (block >= BCH_V1_LOGO_FIRST && block <= BCH_V1_LOGO_LAST)
+		return 2;
+	if (block >= BCH_V1_FIRST_WRITABLE && block < nblocks - BCH_V1_BBT_BLOCKS)
+		return 3;
+	return 0;
+}
+
+#define BCH_V1_WIN_MAX	4
+static struct {
+	int n;
+	int first[BCH_V1_WIN_MAX], last[BCH_V1_WIN_MAX];
+} bch_v1_win;
+static DEFINE_SPINLOCK(bch_v1_win_lock);
+
+static int bch_v1_win_set(const char *val, const struct kernel_param *kp)
+{
+	int first[BCH_V1_WIN_MAX], last[BCH_V1_WIN_MAX];
+	int n = 0, i, len, nb = READ_ONCE(bch_v1_nblocks);
+	const char *p = skip_spaces(val);
+	unsigned long flags;
+
+	if (!*p || sysfs_streq(p, "none")) {
+		n = 0;
+	} else {
+		for (;;) {
+			if (n == BCH_V1_WIN_MAX ||
+			    sscanf(p, "%d,%d%n", &first[n], &last[n], &len) != 2 ||
+			    first[n] < 0 || last[n] < first[n] ||
+			    !bch_v1_area(first[n], nb) ||
+			    bch_v1_area(first[n], nb) != bch_v1_area(last[n], nb))
+				return -EINVAL;
+			n++;
+			p = skip_spaces(p + len);
+			if (!*p)
+				break;
+			if (*p != ';')
+				return -EINVAL;
+			p = skip_spaces(p + 1);
+		}
+	}
+	spin_lock_irqsave(&bch_v1_win_lock, flags);
+	for (i = 0; i < n; i++) {
+		bch_v1_win.first[i] = first[i];
+		bch_v1_win.last[i] = last[i];
+	}
+	bch_v1_win.n = n;
+	spin_unlock_irqrestore(&bch_v1_win_lock, flags);
+	if (!n)
+		pr_info("marvell_nand: program/erase window closed\n");
+	for (i = 0; i < n; i++)
+		pr_warn("marvell_nand: program/erase window blocks %d-%d\n",
+			first[i], last[i]);
+	return 0;
+}
+
+static int bch_v1_win_get(char *buf, const struct kernel_param *kp)
+{
+	unsigned long flags;
+	int i, len = 0;
+
+	spin_lock_irqsave(&bch_v1_win_lock, flags);
+	for (i = 0; i < bch_v1_win.n; i++)
+		len += sysfs_emit_at(buf, len, "%s%d,%d", i ? ";" : "",
+				     bch_v1_win.first[i], bch_v1_win.last[i]);
+	spin_unlock_irqrestore(&bch_v1_win_lock, flags);
+	if (!len)
+		len = sysfs_emit(buf, "none");
+	return len + sysfs_emit_at(buf, len, "\n");
+}
+
+static bool bch_v1_win_has(int block)
+{
+	unsigned long flags;
+	bool in = false;
+	int i;
+
+	spin_lock_irqsave(&bch_v1_win_lock, flags);
+	for (i = 0; i < bch_v1_win.n; i++)
+		if (block >= bch_v1_win.first[i] && block <= bch_v1_win.last[i])
+			in = true;
+	spin_unlock_irqrestore(&bch_v1_win_lock, flags);
+	return in;
+}
+
+static const struct kernel_param_ops bch_v1_win_ops = {
+	.set = bch_v1_win_set,
+	.get = bch_v1_win_get,
+};
+module_param_cb(write_window, &bch_v1_win_ops, NULL, 0644);
+MODULE_PARM_DESC(write_window,
+		 "88PA6170: erase blocks FIRST,LAST[;FIRST,LAST...] that may be programmed or erased (default none)");
