+module_param_named(early_uncerr, bch_v1_early_uncerr, uint, 0444);
+MODULE_PARM_DESC(early_uncerr, "88PA6170: BCH reads that ended in UNCERR");
+module_param_named(reread_ok, bch_v1_reread_ok, uint, 0444);
+MODULE_PARM_DESC(reread_ok, "88PA6170: pages read correctly after a retry");
+static u32 bch_v1_last_ndsr;
+
+static bool bch_v1_block_writable(int block, int nblocks)
+{
+	return (block >= BCH_V1_KERNEL_FIRST && block <= BCH_V1_KERNEL_LAST) ||
+	       (block >= BCH_V1_LOGO_FIRST && block <= BCH_V1_LOGO_LAST) ||
+	       (block >= BCH_V1_FIRST_WRITABLE &&
+		block < nblocks - BCH_V1_BBT_BLOCKS);
+}
+
+static int bch_v1_win_first = -1, bch_v1_win_last = -1;
+
+static int bch_v1_win_set(const char *val, const struct kernel_param *kp)
+{
+	int first, last;
+
+	if (sysfs_streq(val, "none") || sysfs_streq(val, "")) {
+		WRITE_ONCE(bch_v1_win_first, -1);
+		WRITE_ONCE(bch_v1_win_last, -1);
+		return 0;
+	}
+	if (sscanf(val, "%d,%d", &first, &last) != 2 || first < 0 ||
+	    last < first)
+		return -EINVAL;
+	WRITE_ONCE(bch_v1_win_first, -1);
+	WRITE_ONCE(bch_v1_win_last, last);
+	WRITE_ONCE(bch_v1_win_first, first);
+	pr_warn("marvell_nand: program/erase window blocks %d-%d\n", first,
+		last);
+	return 0;
+}
+
+static int bch_v1_win_get(char *buf, const struct kernel_param *kp)
+{
+	if (READ_ONCE(bch_v1_win_first) < 0)
+		return sysfs_emit(buf, "none\n");
+	return sysfs_emit(buf, "%d,%d\n", READ_ONCE(bch_v1_win_first),
+			  READ_ONCE(bch_v1_win_last));
+}
+
+static const struct kernel_param_ops bch_v1_win_ops = {
+	.set = bch_v1_win_set,
+	.get = bch_v1_win_get,
+};
+module_param_cb(write_window, &bch_v1_win_ops, NULL, 0644);
+MODULE_PARM_DESC(write_window,
+		 "88PA6170: erase blocks FIRST,LAST that may be programmed or erased (default none)");
