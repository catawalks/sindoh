+/*
+ * May this flash-changing command go out? Only on bch_v1, only a complete
+ * program (SEQIN + 5 address cycles + PAGEPROG) or erase (ERASE1 + 3 row
+ * cycles + ERASE2) in one command, and only on a block inside the window
+ * and the fixed limits. Everything else that can change the flash (page
+ * loads without PAGEPROG, RNDIN, SET_FEATURES, ...) is refused.
+ */
+static bool marvell_nfc_write_allowed(struct nand_chip *chip,
+				      const struct marvell_nfc_op *op)
+{
+	struct marvell_nfc *nfc = to_marvell_nfc(chip->controller);
+	u32 ndcb0 = op->ndcb[0];
+	u8 cmd1 = ndcb0 & 0xff, cmd2 = (ndcb0 >> 8) & 0xff;
+	unsigned int cyc = (ndcb0 >> 16) & 0x7;
+	int first = READ_ONCE(bch_v1_win_first);
+	int last = READ_ONCE(bch_v1_win_last);
+	int nblocks, block;
+	u32 row;
+
+	if (IS_ENABLED(CONFIG_MTD_RAW_NAND_READ_ONLY) || !nfc->caps->bch_v1 ||
+	    nfc->no_write || first < 0 || !(ndcb0 & NDCB0_DBC))
+		return false;
+	if (cmd1 == NAND_CMD_SEQIN && cmd2 == NAND_CMD_PAGEPROG && cyc == 5)
+		row = (op->ndcb[1] >> 16) | ((op->ndcb[2] & 0xff) << 16);
+	else if (cmd1 == NAND_CMD_ERASE1 && cmd2 == NAND_CMD_ERASE2 && cyc == 3)
+		row = op->ndcb[1] & 0xffffff;
+	else
+		return false;
+
+	block = row / BCH_V1_PAGES_PER_BLOCK;
+	nblocks = nanddev_target_size(&chip->base) >> chip->phys_erase_shift;
+	return block >= first && block <= last &&
+	       bch_v1_block_writable(block, nblocks);
+}
