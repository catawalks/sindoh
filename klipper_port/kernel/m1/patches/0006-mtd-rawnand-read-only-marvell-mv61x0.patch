+/*
+ * CONFIG_MTD_RAW_NAND_READ_ONLY: true for any command that could change
+ * the flash. The decision is on the command bytes the chip will see: a
+ * NAND chip only programs on PAGEPROG/CACHEDPROG, erases on ERASE2 and
+ * changes settings on SET_FEATURES, and every one of them has to go out
+ * as CMD1 or CMD2 of some NDCB0. Page loads (SEQIN, RNDIN) and ERASE1 are
+ * refused too, since no read needs them. Both fields are checked on every
+ * command, whatever DBC says. The command type is not used: this driver
+ * runs plain CMD-ADDR-CMD-WAITRDY reads (READ0/READSTART) through
+ * marvell_nfc_erase_cmd_type_exec, i.e. with TYPE_ERASE as a sequencing
+ * mode, and the chip still only sees a read.
+ */
+static bool marvell_nfc_cmd_may_write(u32 ndcb0)
+{
+	static const u8 cmds[] = { NAND_CMD_SEQIN, NAND_CMD_PAGEPROG,
+				   NAND_CMD_CACHEDPROG, NAND_CMD_ERASE1,
+				   NAND_CMD_ERASE2, NAND_CMD_RNDIN,
+				   NAND_CMD_SET_FEATURES };
+	u8 cmd1 = ndcb0 & 0xff, cmd2 = (ndcb0 >> 8) & 0xff;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cmds); i++)
+		if (cmd1 == cmds[i] || cmd2 == cmds[i])
+			return true;
+	return false;
+}
+
 static void marvell_nfc_send_cmd(struct nand_chip *chip,
 				 struct marvell_nfc_op *nfc_op)
 {
 	struct marvell_nand_chip *marvell_nand = to_marvell_nand(chip);
 	struct marvell_nfc *nfc = to_marvell_nfc(chip->controller);
 
+	if (IS_ENABLED(CONFIG_MTD_RAW_NAND_READ_ONLY) &&
+	    marvell_nfc_cmd_may_write(nfc_op->ndcb[0])) {
+		dev_err_ratelimited(nfc->dev,
+				    "read-only: refused NDCB0 0x%08x\n",
+				    nfc_op->ndcb[0]);
+		WARN_ON_ONCE(1);
+		return;
+	}
+
 	dev_dbg(nfc->dev, "\nNDCR:  0x%08x\n"
 		"NDCB0: 0x%08x\nNDCB1: 0x%08x\nNDCB2: 0x%08x\nNDCB3: 0x%08x\n",
 		(u32)readl_relaxed(nfc->regs + NDCR), nfc_op->ndcb[0],
@@ -1144,6 +1186,105 @@
 						   true, page);
 }
 
+/*
+ * bch_v1 (88PA6170): read one page with BCH in one monolithic command of
+ * three NDCB0 words, as the vendor driver does. On an uncorrectable page,
+ * erased pages included, this controller can end the job with UNCERR and
+ * never assert RDDREQ (NDSR 0x001f1810 seen: UNCERR, ERRCNT 31, RDY, no
+ * RDDREQ/CMDD). No data is transferred then, and the next command times
+ * out. So each page is read raw first; an erased page (by the usual
+ * zero-bit threshold) is returned as 0xff from that read. Only programmed
+ * pages go through the engine. There: wait for RDDREQ or UNCERR; without
+ * data, or with an uncorrectable result, clear NDSR and ND_RUN, re-read
+ * the page raw into the caller's buffers, and let the erased-page check
+ * decide. A programmed page that cannot be corrected counts as a failure
+ * and returns the raw data.
+ */
+static int marvell_nfc_bch_v1_read_page(struct nand_chip *chip, u8 *buf,
+					int oob_required, int page)
+{
+	struct marvell_nand_chip *marvell_nand = to_marvell_nand(chip);
+	struct marvell_nfc *nfc = to_marvell_nfc(chip->controller);
+	const struct marvell_hw_ecc_layout *lt = marvell_nand->layout;
+	struct marvell_nfc_op nfc_op = {
+		.ndcb[0] = NDCB0_CMD_TYPE(TYPE_READ) |
+			   NDCB0_ADDR_CYC(marvell_nand->addr_cyc) |
+			   NDCB0_DBC |
+			   NDCB0_CMD1(NAND_CMD_READ0) |
+			   NDCB0_CMD2(NAND_CMD_READSTART),
+		.ndcb[1] = NDCB1_ADDRS_PAGE(page),
+		.ndcb[2] = NDCB2_ADDR5_PAGE(page),
+	};
+	struct mtd_info *mtd = nand_to_mtd(chip);
+	unsigned int max_bitflips = 0;
+	u32 ndsr;
+	int ret, bf;
+
+	marvell_nfc_select_target(chip, chip->cur_cs);
+
+	/*
+	 * Erased pages first, from a raw read: with ECC on, an erased page
+	 * makes this engine end the job with UNCERR and no data, and the
+	 * following command then times out (NDSR 0x00001800, no CMDD; BCH
+	 * run 2). Checked over data, spare and ECC bytes with the usual
+	 * threshold, an erased page comes back as 0xff here and never goes
+	 * through the BCH engine.
+	 */
+	marvell_nfc_disable_hw_ecc(chip);
+	ret = marvell_nfc_hw_ecc_hmg_do_read_page(chip, buf, chip->oob_poi,
+						  true, page);
+	if (ret)
+		return ret;
+	bf = nand_check_erased_ecc_chunk(buf, lt->data_bytes,
+					 chip->oob_poi + lt->spare_bytes,
+					 lt->ecc_bytes, chip->oob_poi,
+					 lt->spare_bytes, chip->ecc.strength);
+	if (bf >= 0) {
+		mtd->ecc_stats.corrected += bf;
+		return bf;
+	}
+
+	/* A programmed page: read it again through the BCH engine */
+	marvell_nfc_enable_hw_ecc(chip);
+	ret = marvell_nfc_prepare_cmd(chip);
+	if (ret)
+		goto raw;
+	marvell_nfc_send_cmd(chip, &nfc_op);
+	ret = readl_relaxed_poll_timeout(nfc->regs + NDSR, ndsr,
+					 ndsr & (NDSR_RDDREQ | NDSR_UNCERR),
+					 POLL_PERIOD, POLL_TIMEOUT);
+	if (ret || !(ndsr & NDSR_RDDREQ))
+		goto raw;
+	writel_relaxed(NDSR_RDDREQ, nfc->regs + NDSR);
+	marvell_nfc_xfer_data_in_pio(nfc, buf, lt->data_bytes);
+	marvell_nfc_xfer_data_in_pio(nfc, chip->oob_poi, lt->spare_bytes);
+	ret = marvell_nfc_wait_cmdd(chip);
+	if (ret)
+		goto raw;
+	ret = marvell_nfc_hw_ecc_check_bitflips(chip, &max_bitflips);
+	if (!ret) {
+		marvell_nfc_disable_hw_ecc(chip);
+		return max_bitflips;
+	}
+
+raw:
+	/* No data, or uncorrectable: end this job, then read the page raw */
+	writel_relaxed(readl(nfc->regs + NDSR), nfc->regs + NDSR);
+	writel_relaxed(readl(nfc->regs + NDCR) & ~NDCR_ND_RUN,
+		       nfc->regs + NDCR);
+	marvell_nfc_disable_hw_ecc(chip);
+	ret = marvell_nfc_hw_ecc_hmg_do_read_page(chip, buf, chip->oob_poi,
+						  true, page);
+	if (ret)
+		return ret;
+	max_bitflips = 0;
+	marvell_nfc_check_empty_chunk(chip, buf, lt->data_bytes,
+				      chip->oob_poi, lt->spare_bytes,
+				      chip->oob_poi + lt->spare_bytes,
+				      lt->ecc_bytes, &max_bitflips);
+	return max_bitflips;
+}
