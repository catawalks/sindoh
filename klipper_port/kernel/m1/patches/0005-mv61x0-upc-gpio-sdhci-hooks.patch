--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -50,6 +50,16 @@
 	  To compile this driver as a module, choose M here: the
 	  module will be called ad525x_dpot-spi.
 
+config MV61X0_UPC
+	tristate "Marvell 88PA61x0 UPC coprocessors"
+	depends on ARCH_MV61X0 || COMPILE_TEST
+	depends on OF && HAS_IOMEM
+	help
+	  The two UPC cores of the Marvell 88PA61x0 printer SoCs (Sindoh
+	  DP200) with the user interface of the vendor upc.ko: /dev/upc0
+	  and /dev/upc1. Holds the cores and forces their outputs off at
+	  probe, on removal, reboot and panic.
+
 config DUMMY_IRQ
 	tristate "Dummy IRQ handler"
 	help
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -75,3 +75,4 @@
 obj-y				+= keba/
 obj-y				+= amd-sbi/
 obj-$(CONFIG_MISC_RP1)		+= rp1/
+obj-$(CONFIG_MV61X0_UPC)	+= mv61x0-upc.o
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -506,6 +506,16 @@
 	help
 	  Say yes here to support the Mediatek MT7621 SoC GPIO device.
 
+config GPIO_MV61X0
+	tristate "Marvell 88PA61x0 GPIO"
+	depends on ARCH_MV61X0 || COMPILE_TEST
+	depends on OF
+	select GPIO_GENERIC
+	select GPIOLIB_IRQCHIP
+	help
+	  The eight 32-line GPIO banks of the Marvell 88PA61x0 printer
+	  SoCs (Sindoh DP200). Nothing is driven at probe.
+
 config GPIO_MVEBU
 	bool "Marvell Orion and EBU GPIO support" if COMPILE_TEST
 	depends on PLAT_ORION || ARCH_MVEBU || COMPILE_TEST
--- a/drivers/gpio/Makefile
+++ b/drivers/gpio/Makefile
@@ -217,3 +217,4 @@
 obj-$(CONFIG_GPIO_ZEVIO)		+= gpio-zevio.o
 obj-$(CONFIG_GPIO_ZYNQ)			+= gpio-zynq.o
 obj-$(CONFIG_GPIO_ZYNQMP_MODEPIN)	+= gpio-zynqmp-modepin.o
+obj-$(CONFIG_GPIO_MV61X0)		+= gpio-mv61x0.o
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -367,6 +367,15 @@
 
 	  If unsure, say N.
 
+config MMC_SDHCI_MV61X0
+	tristate "Marvell 88PA61x0 SDHCI"
+	depends on ARCH_MV61X0 || COMPILE_TEST
+	depends on MMC_SDHCI_PLTFM && OF
+	select MMC_SDHCI_IO_ACCESSORS
+	help
+	  The SD/MMC slots of the Marvell 88PA61x0 printer SoCs (Sindoh
+	  DP200), with the vendor's register quirks.
+
 config MMC_SDHCI_PXAV3
 	tristate "Marvell MMP2 SD Host Controller support (PXAV3)"
 	depends on HAVE_CLK
--- a/drivers/mmc/host/Makefile
+++ b/drivers/mmc/host/Makefile
@@ -114,3 +114,4 @@
 
 obj-$(CONFIG_MMC_SDHCI_XENON)	+= sdhci-xenon-driver.o
 sdhci-xenon-driver-y		+= sdhci-xenon.o sdhci-xenon-phy.o
+obj-$(CONFIG_MMC_SDHCI_MV61X0)	+= sdhci-mv61x0.o
