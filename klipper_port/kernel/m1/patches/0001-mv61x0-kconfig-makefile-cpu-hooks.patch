--- a/arch/arm/mm/proc-v7.S
+++ b/arch/arm/mm/proc-v7.S
@@ -431,6 +431,40 @@
 #endif
 	b	__errata_finish
 
+#ifdef CONFIG_ARCH_MV61X0
+/*
+ * PJ4B-MP of the Marvell 88PA61x0 (A9-style SCU and GIC): the settings of
+ * the vendor 3.2 kernel's __v7_pj4bmp_setup, which differ from the
+ * Armada XP oriented __v7_pj4b_setup below.
+ */
+__v7_pj4bmp_setup:
+	mrc	p15, 1, r0, c15, c1, 0		@ Aux Debug Modes Control 0
+	orr	r0, r0, #(1 << 12)
+	mcr	p15, 1, r0, c15, c1, 0
+	mrc	p15, 1, r0, c15, c1, 2		@ Aux Debug Modes Control 2
+	orr	r0, r0, #(1 << 29)		@ no outstanding non-cacheable requests
+	bic	r0, r0, #(1 << 23)		@ fast LDR
+	mcr	p15, 1, r0, c15, c1, 2
+	mrc	p15, 1, r0, c15, c1, 1		@ Aux Debug Modes Control 1
+	bic	r0, r0, #(1 << 25)
+	mcr	p15, 1, r0, c15, c1, 1
+	mrc	p15, 1, r0, c15, c2, 0		@ Aux Functional Modes Control 0
+	bic	r0, r0, #(1 << 7)
+	mcr	p15, 1, r0, c15, c2, 0
+	dsb
+	isb
+#ifdef CONFIG_SMP
+	mrc	p15, 0, r0, c0, c1, 7		@ ID_MMFR3
+	and	r0, r0, #0xf000
+	cmp	r0, #0x2000			@ maintenance broadcast?
+	mrc	p15, 0, r0, c1, c0, 1		@ ACTLR
+	orreq	r0, r0, #(1 << 0)		@ FW
+	orr	r0, r0, #(1 << 6)		@ SMP
+	mcr	p15, 0, r0, c1, c0, 1
+#endif
+	b	__v7_setup
+#endif
+
 __v7_pj4b_setup:
 #ifdef CONFIG_CPU_PJ4B
 
@@ -705,6 +739,14 @@
 	/*
 	 * Marvell PJ4B processor.
 	 */
+#ifdef CONFIG_ARCH_MV61X0
+	.type   __v7_pj4bmp_proc_info, #object
+__v7_pj4bmp_proc_info:
+	.long	0x560f5840
+	.long	0xff0ffff0
+	__v7_proc __v7_pj4bmp_proc_info, __v7_pj4bmp_setup, proc_fns = pj4b_processor_functions
