--- a/drivers/mtd/nand/raw/marvell_nand.c
+++ b/drivers/mtd/nand/raw/marvell_nand.c
@@ -617,6 +617,121 @@
  * specialized functions responsible for executing the actual NAND
  * operations do not have to replicate the same code blocks.
  */
+/*
+ * Debug trace (88PA6170, DP200): the last NAND controller steps, written to
+ * a 4 KB RAM area that the DT reserves as no-map, so that they survive a
+ * warm reset (the timer-0 hang watchdog) and the next boot can print them.
+ * Off unless marvell_nand.trace_phys is set. Each entry: sequence number,
+ * time (us, monotonic), step, CPU, IRQs-off flag and up to three values.
+ */
+static ulong bch_v1_tr_phys;
+module_param_named(trace_phys, bch_v1_tr_phys, ulong, 0444);
+MODULE_PARM_DESC(trace_phys,
+		 "88PA6170 debug: physical address of a 4 KB no-map RAM area for the NAND step trace (0: off)");
+
+#define BT_MAGIC	0x3152544e	/* "NTR1" */
+#define BT_N		126
+
+struct bt_ent {
+	u32 seq, us, step, a, b, c, d, pad;
+};
+
+struct bt_ring {
+	u32 magic, seq, boot, pad[13];
+	struct bt_ent e[BT_N];
+};
+
+enum {
+	BT_CMD = 1,	/* a, b, c = NDCB0..2 */
+	BT_IN,		/* PIO from NDDB starts: a = length */
+	BT_IN_END,
+	BT_OUT,		/* PIO to NDDB starts: a = length */
+	BT_OUT_END,
+	BT_WAIT,	/* wait_op (R/B interrupt): a = timeout ms */
+	BT_WAIT_END,	/* a = completion result, b = pending NDSR bits */
+	BT_POLL,	/* end_cmd polling NDSR: a = flag */
+	BT_POLL_END,	/* a = ret, b = NDSR */
+	BT_ISR,		/* a = NDSR */
+	BT_RDD,		/* bch_v1 read: polling for RDDREQ, a = page */
+	BT_RDD_END,	/* a = ret, b = NDSR */
+	BT_STOP,	/* bch_v1_stop: a = NDCR before */
+};
+
+static const char * const bt_name[] = {
+	"?", "cmd", "pio-in", "pio-in-end", "pio-out", "pio-out-end",
+	"wait", "wait-end", "poll", "poll-end", "isr", "rdd", "rdd-end", "stop",
+};
+
+static struct bt_ring __iomem *bt;
+static atomic_t bt_seq = ATOMIC_INIT(0);
+
+static void bt_log(u32 step, u32 a, u32 b, u32 c)
+{
+	struct bt_ent __iomem *e;
+	u32 seq;
+
+	if (!bt)
+		return;
+	seq = atomic_inc_return(&bt_seq);
+	e = &bt->e[seq % BT_N];
+	writel_relaxed(0, &e->seq);
+	writel_relaxed((u32)(ktime_get_mono_fast_ns() >> 10), &e->us);
+	writel_relaxed(step | raw_smp_processor_id() << 8 |
+		       !!irqs_disabled() << 12 | !!in_interrupt() << 13,
+		       &e->step);
+	writel_relaxed(a, &e->a);
+	writel_relaxed(b, &e->b);
+	writel_relaxed(c, &e->c);
+	writel(seq, &e->seq);
+	writel(seq, &bt->seq);
+}
+
+/* At probe: print what the boot before left, then start a new ring */
+static void bt_init(struct device *dev)
+{
+	u32 last, seq, step, i, n = 0;
+	struct bt_ent __iomem *e;
+
+	if (!bch_v1_tr_phys)
+		return;
+	bt = ioremap(bch_v1_tr_phys, sizeof(*bt));
+	if (!bt) {
+		dev_err(dev, "trace: cannot map %#lx\n", bch_v1_tr_phys);
+		return;
+	}
+	if (readl(&bt->magic) == BT_MAGIC) {
+		last = readl(&bt->seq);
+		dev_warn(dev, "trace of boot %u, last step #%u:\n",
+			 readl(&bt->boot), last);
+		for (i = last >= BT_N ? last - BT_N + 1 : 1; i <= last; i++) {
+			e = &bt->e[i % BT_N];
+			seq = readl(&e->seq);
+			if (seq != i)
+				continue;
+			step = readl(&e->step);
+			dev_warn(dev, "trace #%u %u us cpu%u%s%s %s %08x %08x %08x\n",
+				 seq, readl(&e->us), (step >> 8) & 0xf,
+				 step & BIT(12) ? " irqoff" : "",
+				 step & BIT(13) ? " intr" : "",
+				 bt_name[(step & 0xff) < ARRAY_SIZE(bt_name) ?
+					 (step & 0xff) : 0],
+				 readl(&e->a), readl(&e->b), readl(&e->c));
+			n++;
+		}
+		dev_warn(dev, "trace: %u steps shown\n", n);
+		writel(readl(&bt->boot) + 1, &bt->boot);
+	} else {
+		dev_info(dev, "trace: no earlier trace at %#lx\n",
+			 bch_v1_tr_phys);
+		writel(1, &bt->boot);
+	}
+	memset_io(bt->e, 0, sizeof(bt->e));
+	writel(0, &bt->seq);
+	writel(BT_MAGIC, &bt->magic);
+	dev_info(dev, "trace: NAND steps to %#lx (boot %u)\n",
+		 bch_v1_tr_phys, readl(&bt->boot));
+}
