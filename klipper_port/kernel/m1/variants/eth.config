# Ethernet loader: the smallest image that brings up stmmac, gets an
# address and kexecs the real test image fetched from the PC (ethload).
# Uniprocessor (kexec without CPU hotplug), no USB, Wi-Fi, media or panel.
# CONFIG_SMP is not set
CONFIG_KEXEC=y
CONFIG_PACKET=y
# CONFIG_USB_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_WLAN is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VT is not set
# CONFIG_FB is not set
# CONFIG_INPUT is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_INET_DIAG is not set
# CONFIG_FW_LOADER is not set
# Symbols of m1.config that disappear with the options above
# m1-ignore: CONFIG_NR_CPUS CONFIG_USB CONFIG_USB_ANNOUNCE_NEW_DEVICES
# m1-ignore: CONFIG_USB_EHCI_HCD CONFIG_USB_EHCI_ROOT_HUB_TT
# m1-ignore: CONFIG_USB_EHCI_HCD_PLATFORM CONFIG_CFG80211_CERTIFICATION_ONUS
# m1-ignore: CONFIG_WLAN_VENDOR_MARVELL CONFIG_MWIFIEX CONFIG_MWIFIEX_USB
# m1-ignore: CONFIG_MEDIA_CAMERA_SUPPORT CONFIG_MEDIA_USB_SUPPORT
# m1-ignore: CONFIG_USB_VIDEO_CLASS CONFIG_VT_CONSOLE CONFIG_FB_DEVICE
# m1-ignore: CONFIG_FB_SIMPLE CONFIG_FRAMEBUFFER_CONSOLE
