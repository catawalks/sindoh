# HANGTEST=nanddsb: nandclrex (plain nandboot, two CPUs, hang watchdog, the
# reworked 6011 patch, clrex on exception return) plus patch 0025: every
# data barrier is "dsb sy", as in the vendor kernel.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_PJ4B_MV61X0_DSB_BARRIERS=y
