# UBI + UBIFS on the NAND, read-only: the nand variant (patch 0006: ROM,
# -EROFS paths, command-byte guard; BCH bch_v1 reads; no BBT) plus UBI,
# which runs in ro_mode on an MTD without MTD_WRITEABLE, and UBIFS mounted
# -o ro. No mtdblock. Kept small: no USB, Wi-Fi, media or firmware.
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_MARVELL=y
CONFIG_MTD_RAW_NAND_READ_ONLY=y
# CONFIG_MTD_BLOCK is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_WLAN is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VT is not set
# CONFIG_FB is not set
# CONFIG_INPUT is not set
# CONFIG_FW_LOADER is not set
# m1-ignore: CONFIG_USB CONFIG_USB_ANNOUNCE_NEW_DEVICES
# m1-ignore: CONFIG_USB_EHCI_HCD CONFIG_USB_EHCI_ROOT_HUB_TT
# m1-ignore: CONFIG_USB_EHCI_HCD_PLATFORM CONFIG_CFG80211_CERTIFICATION_ONUS
# m1-ignore: CONFIG_WLAN_VENDOR_MARVELL CONFIG_MWIFIEX CONFIG_MWIFIEX_USB
# m1-ignore: CONFIG_MEDIA_CAMERA_SUPPORT CONFIG_MEDIA_USB_SUPPORT
# m1-ignore: CONFIG_USB_VIDEO_CLASS CONFIG_VT_CONSOLE CONFIG_FB_DEVICE
# m1-ignore: CONFIG_FB_SIMPLE CONFIG_FRAMEBUFFER_CONSOLE
# UBI attaches in read-only mode on its own (the MTD has no MTD_WRITEABLE:
# drivers/mtd/ubi/build.c sets ro_mode); UBIFS is mounted -o ro. No fastmap.
CONFIG_MTD_UBI=y
# CONFIG_MTD_UBI_FASTMAP is not set
# UBIFS sits in the "Miscellaneous filesystems" menu
CONFIG_MISC_FILESYSTEMS=y
CONFIG_UBIFS_FS=y
