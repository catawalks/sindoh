# HANGTEST=nand6011: nandwdt (plain nandboot, two CPUs, hang watchdog) with
# the reworked erratum 6011 patch (IRQs off for the five loads only).
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
