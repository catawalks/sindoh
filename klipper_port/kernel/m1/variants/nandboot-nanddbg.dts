/*
 * m1-nandboot-nanddbg: nandboot plus a ramoops area for pstore (1 MB at
 * 0x1e000000, as in nandboot-errata-dbg.dts) and, right after it, 4 KB of
 * no-map RAM for the NAND step trace (marvell_nand.trace_phys, patch
 * 0015). Both are clear of what the stock U-Boot uses (see
 * nandboot-errata-dbg.dts).
 */
#include "nandboot.dts"

/ {
	reserved-memory {
		ramoops@1e000000 {
			compatible = "ramoops";
			reg = <0x1e000000 0x00100000>;
			record-size = <0x00020000>;	/* 3 dmesg records */
			console-size = <0x00080000>;
			pmsg-size = <0x00020000>;
			ecc-size = <16>;
		};

		nandtrace@1e100000 {
			reg = <0x1e100000 0x00001000>;
			no-map;
		};
	};
};
