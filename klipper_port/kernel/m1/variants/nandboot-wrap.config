# HANGTEST=wrap (docs/kernel/nandboot_hang_analysis.md, test 2, first half):
# SMP nandboot with the vendor's wrapper around D-cache maintenance
# (patch 0011), plus the buddy hard-lockup detector with panic.
CONFIG_PJ4B_MV61X0_CACHE_WRAP=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
