# HANGTEST=nandps4 (docs/kernel/nandboot_hang_analysis.md, hang 25): nandps3
# (PSTORE + PSTORE_RAM, no CONSOLE/PMSG/COMPRESS, no ramoops device) with
# CONFIG_MV61X0_RAMOOPS_NO_INIT (patch 0023): ramoops_init returns at once,
# so the ramoops platform driver is never registered.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_CONSOLE is not set
# CONFIG_PSTORE_PMSG is not set
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_MV61X0_RAMOOPS_NO_INIT=y
