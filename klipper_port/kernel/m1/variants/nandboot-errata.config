# HANGTEST=errata (docs/kernel/nandboot_hang_analysis.md, test 2): SMP
# nandboot with both vendor PJ4B workarounds, the D-cache maintenance
# wrapper (patch 0011) and erratum 6011 (patch 0012), plus the buddy
# hard-lockup detector with panic.
CONFIG_PJ4B_MV61X0_CACHE_WRAP=y
CONFIG_PJ4B_ERRATA_6011=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
