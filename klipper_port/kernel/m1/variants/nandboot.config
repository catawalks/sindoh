# "nandboot": the end-goal image for mtd0 (docs/end_goal_install_plan.md,
# stage 3/4). build.sh puts full.config first, then this file, and always
# builds it with NANDW=1 and without the 8782 firmware (a Marvell binary:
# the root carries it, see docs/kernel/nand_boot_cmdline.md).
# The stock U-Boot line (ubi.mtd=filesystem, mtdparts, ...) is ignored:
# the initramfs picks the root, and mtd6 is writable from boot on.
# Two CPUs since 2026-11-11. With both PJ4B cores the plain kernel froze
# hard (both CPUs and the bus stall) after minutes to hours, so the default
# ran maxcpus=1 from 11-09. The fix is the vendor's three habits together:
# erratum 6011 (five LDREX, IRQs off for the loads), clrex on exception
# return (patch 0024, under PJ4B_ERRATA_6011) and "dsb sy" for every data
# barrier (patch 0025). 10 h two-CPU NAND-root soak clean
# (docs/kernel/smp_freeze_summary.md).
# timer_mv61x0.hang_wdt=30 arms the timer-0 hang watchdog: a freeze resets
# the board after 30 s. Kept in the default by the owner's choice (11-11);
# this is the command line of the soaked image in mtd0 (nanddsb a4e0cb33).
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_CMDLINE_FORCE=y
# USB sticks (Sindoh update stick, revert stick, storage tier)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
# Wi-Fi as modules (2026-11-07): built in, mwifiex probed the 8782 from the
# initramfs before the root (and its firmware) was there, gave the device
# up, and needed a re-enumerate. init.mainline insmods them from
# /lib/modules/<version> in the root (build.sh packs them).
# m1-ignore: CONFIG_MWIFIEX CONFIG_MWIFIEX_USB
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_USB=m
# With modules on, the DVB frontends and tuners default to m unless media
# sub-drivers are autoselected (by a bridge driver; none here): keep the
# media side as it was without modules
CONFIG_MEDIA_SUBDRV_AUTOSELECT=y
# Hang diagnostics (one unexplained hang, 2026-11-07): a soft lockup
# panics, and panic=10 reboots; hung tasks and stalled workqueues are
# logged. Netconsole can be set up at run time (configfs) to send the
# kernel log over Ethernet.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_WQ_WATCHDOG=y
CONFIG_CONFIGFS_FS=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
# The vendor's PJ4B workarounds (patches 0011, 0012), default since
# 2026-11-07: plain nandboot hard-hung under SD load 3 times, the image
# with these passed ~97 min of the same load
# (docs/kernel/nandboot_hang_analysis.md). The buddy hard-lockup detector
# panics a CPU that stops taking interrupts while the other still runs.
CONFIG_PJ4B_MV61X0_CACHE_WRAP=y
CONFIG_PJ4B_ERRATA_6011=y
CONFIG_PJ4B_MV61X0_DSB_BARRIERS=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
# The 88W8782 started the Marvell SDK's way (patches 0013, 0014), default
# since 2026-11-07: no winner probe, the firmware's INIT_DONE read from EP1
# right after the download instead of a 500 ms sleep, the TX command URB
# killed before it is freed, and a short trace of the first EP1 transfers.
# Unpatched, the first command (FUNC_INIT) went unanswered on about 7 of 10
# warm boots and 1 of 3 cold; patched, 19 of 19 warm boots came up, INIT_DONE
# 56 ms after the download each time (docs/kernel/wifi_boot_failure.md).
CONFIG_MWIFIEX_USB_8782_START=y
