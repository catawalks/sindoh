# HANGTEST=nandwdt (docs/kernel/nandboot_hang_analysis.md, hang 16): the
# plain nandboot image (all patches, their defaults) plus only the hang
# watchdog. No NAND trace, PC sampler, tick check or ramoops: it tells
# whether the debug additions raise the freeze rate.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
# - timer_mv61x0.hang_wdt=30: timer 0 resets the board 30 s after the last
#   kick (a kworker kicks every 5 s), so a hard hang reboots by itself.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
