# BusyBox applets for the milestone-1 initramfs, applied over
# "make allnoconfig" by build.sh. Static, linked against musl.
CONFIG_STATIC=y
# musl's off_t is always 64-bit
CONFIG_LFS=y
CONFIG_BUSYBOX=y
CONFIG_SHOW_USAGE=y
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=64
CONFIG_FEATURE_TAB_COMPLETION=y
# shell
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_CMDCMD=y
# $(( )) arithmetic, used by /etc/m1-checks.sh
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_CTTYHACK=y
CONFIG_SETSID=y
# files and text
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MKNOD=y
CONFIG_CHMOD=y
CONFIG_DD=y
CONFIG_CMP=y
CONFIG_HEAD=y
CONFIG_CHROOT=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_WC=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_SED=y
CONFIG_GREP=y
CONFIG_HEXDUMP=y
CONFIG_MD5SUM=y
CONFIG_ECHO=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_PWD=y
CONFIG_ENV=y
# system
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_UBIATTACH=y
CONFIG_DMESG=y
CONFIG_UNAME=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_DATE=y
CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_USLEEP=y
CONFIG_TIME=y
CONFIG_WATCH=y
CONFIG_NPROC=y
CONFIG_SYNC=y
CONFIG_STTY=y
CONFIG_DEVMEM=y
CONFIG_I2CDETECT=y
CONFIG_LSUSB=y
# network
CONFIG_IFCONFIG=y
CONFIG_FEATURE_IFCONFIG_STATUS=y
CONFIG_ROUTE=y
CONFIG_PING=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_TFTP=y
CONFIG_FEATURE_TFTP_GET=y
CONFIG_FEATURE_TFTP_PUT=y
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_WGET=y
CONFIG_UDHCPC=y
# allnoconfig leaves the event script path empty: udhcpc then gets a
# lease but never applies it (wifi_join_test1)
CONFIG_UDHCPC_DEFAULT_SCRIPT="/usr/share/udhcpc/default.script"
CONFIG_KILLALL=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
