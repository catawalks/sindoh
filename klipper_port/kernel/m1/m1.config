# Milestone 1 for the Sindoh DP200 (Marvell 88PA6170), merged on top of
# "make tinyconfig" by build.sh. Aim: the smallest zImage that boots from
# RAM to a BusyBox shell on UART0, with GIC and the SoC timer, because it
# may have to be typed into U-Boot with mw.l at 115200 baud.

# Platform. tinyconfig turns the MMU off on ARM (v7-M), so turn it on.
# ARCH_MULTIPLATFORM=n only to allow DEBUG_UNCOMPRESS.
CONFIG_MMU=y
# CONFIG_ARCH_MULTIPLATFORM is not set
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MV61X0=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HZ_100=y
CONFIG_HZ_PERIODIC=y
# CONFIG_HIGH_RES_TIMERS is not set
# CONFIG_CACHE_L2X0 is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM is not set
# CONFIG_HIGHMEM is not set
# CONFIG_THUMB2_KERNEL is not set
CONFIG_AEABI=y
CONFIG_ARM_THUMB=y
CONFIG_VFP=y
CONFIG_VFPv3=y

# Boot: zImage + appended DTB, bootm from U-Boot 2011.09 (ATAGS in r2).
# U-Boot's bootargs are appended to the DT bootargs. AUTO_ZRELADDR and
# PATCH_PHYS_VIRT must be on, or tinyconfig leaves PHYS_OFFSET at 8 MB.
CONFIG_AUTO_ZRELADDR=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_CMDLINE=""
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Early output on UART0 (0xf8060000, 32-bit registers, shift 2), mapped
# at 0xfe060000 once the MMU is on.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_8250=y
CONFIG_DEBUG_UART_PHYS=0xf8060000
CONFIG_DEBUG_UART_VIRT=0xfe060000
CONFIG_DEBUG_UART_8250_SHIFT=2
CONFIG_DEBUG_UART_8250_WORD=y
CONFIG_DEBUG_UNCOMPRESS=y
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y

# Console
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_EXTENDED is not set
# CONFIG_SERIAL_8250_DEPRECATED_OPTIONS is not set
# CONFIG_SERIAL_8250_DW is not set

# Userspace: built-in initramfs (left uncompressed, XZ covers the zImage)
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@INITRAMFS_LIST@"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
# musl uses the time32 syscalls (nanosleep, ppoll, futex...) whenever the
# value fits in 32 bits; without these, timed sleeps fail with ENOSYS and
# BusyBox's sleep returns at once (boot 3)
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_POSIX_TIMERS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# /dev/mem for "devmem" register reads from the shell
CONFIG_DEVMEM=y

# Not needed for milestone 1 (tinyconfig leaves these on)
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_COMPACTION is not set
# CONFIG_CROSS_MEMORY_ATTACH is not set
# CONFIG_STRICT_KERNEL_RWX is not set
CONFIG_LOG_BUF_SHIFT=15
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_KALLSYMS is not set
