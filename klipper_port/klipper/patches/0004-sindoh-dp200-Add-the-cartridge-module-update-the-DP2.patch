From a1b365cd5f9077c7144fa046ff7a562630a94259 Mon Sep 17 00:00:00 2001
From: catawalks <59056948+catawalks@users.noreply.github.com>
Date: Wed, 21 Oct 2026 19:55:37 -0400
Subject: [PATCH 04/10] sindoh-dp200: Add the cartridge module, update the
 DP200 configuration

- dp200_cartridge: read-only support for the DP200 filament cartridge chip
  (DS28E22 via the DS2465 I2C-to-1-Wire bridge): material, total, used and
  remaining length, CARTRIDGE_READ.
- Config: bed sensor table calibrated to the surface temperature, bed
  max_power 1.0, measured PID defaults, CARTRIDGE_RELEASE (cartridge latch
  solenoid), UNLOAD_FILAMENT turns the heater off, [dp200_cartridge].

Signed-off-by: catawalks <59056948+catawalks@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 config/sindoh-dp200/dp200_macros.cfg  |  15 ++-
 config/sindoh-dp200/dp200_printer.cfg |  39 +++---
 config/sindoh-dp200/printer.cfg       |  15 ++-
 klippy/extras/dp200_cartridge.py      | 184 ++++++++++++++++++++++++++
 4 files changed, 229 insertions(+), 24 deletions(-)
 create mode 100644 klippy/extras/dp200_cartridge.py

diff --git a/config/sindoh-dp200/dp200_macros.cfg b/config/sindoh-dp200/dp200_macros.cfg
index b7f6ace7..cfc84e12 100644
--- a/config/sindoh-dp200/dp200_macros.cfg
+++ b/config/sindoh-dp200/dp200_macros.cfg
@@ -57,13 +57,21 @@ pin: pwm6
 value: 0
 shutdown_value: 0
 
-# Solenoid (dec_pwm block 8) - not used by the stock load/unload; exposed
-# for experiments only.
+# Solenoid (dec_pwm block 8): lifts the cartridge release latch (stock
+# StepperSolenoidOn/Off). 1.5 s is too short to pull the cartridge out, 4 s works.
 [output_pin solenoid]
 pin: pwm8
 value: 0
 shutdown_value: 0
 
+[gcode_macro CARTRIDGE_RELEASE]
+description: Lift the cartridge latch for 4 s so the cartridge can be pulled out (unload the filament first)
+gcode:
+    SET_PIN PIN=solenoid VALUE=1
+    G4 P4000
+    SET_PIN PIN=solenoid VALUE=0
+    M118 Cartridge latch released
+
 # Cartridge-detect lever: xena46, 0 = lever up (cartridge or filament holding
 # it), 1 = down. Sindoh's open-filament mode tapes it up. Filament alone
 # CAN hold it up, but it read "empty" after cold feeds with filament loaded
@@ -221,6 +229,9 @@ gcode:
     M400
     SET_PIN PIN=clutch VALUE=0
     SET_FILAMENT_SENSOR SENSOR=filament_encoder ENABLE=1
+    {% if printer.print_stats.state not in ["printing", "paused"] %}
+        M104 S0                     # nothing left to melt: heater off (kept during a paused print)
+    {% endif %}
     M118 Unload complete ({c.unload_slow + rest} mm) - pull the filament out of the inlet
 
 # ---------------------------------------------------------------------
