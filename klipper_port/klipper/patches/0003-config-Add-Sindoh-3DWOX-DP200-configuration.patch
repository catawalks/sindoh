--- /dev/null
+++ b/config/sindoh-dp200/dp200_macros.cfg
@@ -0,0 +1,535 @@
+# =====================================================================
+# Sindoh DP200 macros reconstructed from the stock firmware
+# =====================================================================
+# Source: stock main program (engine_filaUnload, engine_filaLoad,
+# engine_cleaningXYMove, engine_changelvsensor) + FM microcode commands
+# 0x0f/0x10/0x11 (insert), 0x13 (eject) + karas.db CONF_ENGINE_* row NO=4.
+# Unit conversion: positions in engine pulses / steps-per-mm; speeds are
+# engine half-periods: mm/s = 198010000 / (2 * SPD * steps_per_mm).
+# See docs/stock_routines.md for the raw values.
+#
+# Included by printer.cfg (next to dp200_printer.cfg). Replaced on updates.
+
+# ---------------------------------------------------------------------
+# Build-area lamp ([output_pin lamp] in dp200_printer.cfg, dec_pwm block 7)
+# ---------------------------------------------------------------------
+[gcode_macro LAMP_ON]
+description: Switch the build-area lamp on. BRIGHTNESS=0.0..1.0 (default 1)
+gcode:
+    {% set b = params.BRIGHTNESS|default(1)|float %}
+    SET_PIN PIN=lamp VALUE={[[b, 0.0]|max, 1.0]|min}
+
+[gcode_macro LAMP_OFF]
+description: Switch the build-area lamp off
+gcode:
+    SET_PIN PIN=lamp VALUE=0
+
+[gcode_macro LAMP_TOGGLE]
+description: Toggle the build-area lamp
+gcode:
+    {% if printer["output_pin lamp"].value > 0 %}
+        LAMP_OFF
+    {% else %}
+        LAMP_ON
+    {% endif %}
+
+# Marlin's case-light command, as some slicers/start scripts emit it:
+# M355 S1 (on) / S0 (off), optional P0..255 brightness
+[gcode_macro M355]
+description: Case light (Marlin): S1 on / S0 off, P0-255 brightness
+gcode:
+    {% set s = params.S|default(1)|int %}
+    {% set p = params.P|default(255)|float %}
+    {% if s == 0 %}
+        LAMP_OFF
+    {% else %}
+        LAMP_ON BRIGHTNESS={p / 255.0}
+    {% endif %}
+# =====================================================================
+
+[save_variables]
+filename: ~/printer_data/config/dp200_variables.cfg
+
+# Filament drive clutch (dec_pwm block 6). The stock firmware engages it
+# for every filament feed/retract from the cartridge.
+[output_pin clutch]
+pin: pwm6
+value: 0
+shutdown_value: 0
+
+# Solenoid (dec_pwm block 8) - not used by the stock load/unload; exposed
+# for experiments only.
+[output_pin solenoid]
+pin: pwm8
+value: 0
+shutdown_value: 0
+
+# Cartridge-detect lever: xena46, 0 = lever up (cartridge or filament holding
+# it), 1 = down. Sindoh's open-filament mode tapes it up. Filament alone
+# CAN hold it up, but it read "empty" after cold feeds with filament loaded
+# (2026-10-18), so it only reports - it does not pause prints.
+[filament_switch_sensor cartridge_lever]
+switch_pin: !xena46
+pause_on_runout: False
+runout_gcode:
+    M118 Cartridge lever reports no filament (informational)
+
+# Filament encoder: dec_sensor +0x210 bit 7 (dsens7). One short low pulse
+# per ~16.5 mm of filament (measured 2026-10-18), wheel ~60 mm past the
+# inlet. This is the runout/jam sensor. detection_length covers ~3 pulses.
+[filament_motion_sensor filament_encoder]
+switch_pin: dsens7
+detection_length: 50
+extruder: extruder
+pause_on_runout: True
+runout_gcode:
+    M118 Filament encoder stopped moving - runout or jam
+
+[gcode_macro _DP200]
+description: Stock-derived constants (karas.db row 4)
+# load / unload park position (INSERT 001_3, EJECT 101_02)
+variable_park_x: 229.0
+variable_park_y: 0.0
+variable_park_z: 23.1
+# nozzle cleaning / purge bin (CONF_ENGINE_CLEANING)
+variable_clean_x1: 231.2
+variable_clean_x2: 209.0
+variable_clean_y: 5.5
+variable_clean_z: 10.0
+variable_clean_purge: 20.0          # AutoFilaDisatance 9176
+variable_clean_purge_speed: 10.0    # AutoFilaSpeed 21579
+variable_clean_retract: 15.0        # AutoFilaRetraction -6882
+variable_clean_retract_speed: 40.0  # AutoFilaRetSpeed 5394
+variable_clean_delay: 3             # AutoCleaningTimeDelay
+variable_clean_wipes: 2             # AutoCleaningMoveCnt
+variable_clean_wipe_speed: 80.0     # AutoCleaningSpeed 15469
+variable_bin_threshold: 15          # TRASHCAN_CLEANING_REQUIRED_THRESHOLD
+# temperatures (INSERT/EJECT 001_2 / 101_01: target, wait threshold)
+variable_temp_pla: 230
+variable_temp_abs: 250
+variable_thresh_pla: 210
+variable_thresh_abs: 230
+# unload (FM cmd 0x13 with EJECT block)
+variable_unload_slow: 50.0          # 103_04_PRE_PULSE 22941
+variable_unload_slow_speed: 10.0    # 103_04_PRE_SPD 21579
+variable_unload_fast_speed: 25.0    # 103_04_SPD 8631
+# load (FM cmds 0x0f / 0x10 / 0x11 with INSERT block)
+variable_load_feed_speed: 40.0      # 001_4_SPD 5394
+variable_load_purge: 42.5           # 003_2_PULSE 19500 (after plastic reaches the nozzle)
+variable_load_purge_speed: 3.0      # 003_1_SPD 71951
+variable_load_dwell: 1.0            # 003_3_DELAY 1000 ms
+variable_load_retract: 15.0         # 003_4_PULSE 6882
+variable_load_retract_speed: 40.0   # 003_3_SPD 5394
+variable_load_settle: 3             # 003_5_DELAY
+# Open-filament path, measured 2026-10-18 (tools/ktest_feed.py, ktest_load.py):
+# inlet (feeder gears) -> gear-train exit ~100 mm, bowden tube 330-340 mm,
+# inlet -> nozzle (first plastic) ~515-520 mm.
+variable_inlet_to_nozzle: 518.0
+variable_load_fast: 440.0           # fast feed, stops ~78 mm before the nozzle
+variable_unload_extra: 30.0         # retract past the inlet so the gears let go
+variable_e_chunk: 40.0              # stay under max_extrude_only_distance
+gcode:
+    M118 DP200 constants macro (no action)
+
+[gcode_macro _SINDOH_ENSURE_HOMED]
+gcode:
+    {% if printer.toolhead.homed_axes != "xyz" %}
+        G28
+    {% endif %}
+
+[gcode_macro _SINDOH_TEMP]
+description: Resolve TEMP/MATERIAL params into target and wait-threshold
+gcode:
+    {% set c = printer["gcode_macro _DP200"] %}
+    {% set mat = params.MATERIAL|default("PLA")|upper %}
+    {% set t = params.TEMP|default(c.temp_abs if mat == "ABS" else c.temp_pla)|float %}
+    {% set th = c.thresh_abs if mat == "ABS" else c.thresh_pla %}
+    {% if params.TEMP is defined %}{% set th = t - 20 %}{% endif %}
+    M104 S{t}
+    TEMPERATURE_WAIT SENSOR=extruder MINIMUM={th}
+
+# ---------------------------------------------------------------------
+# Nozzle cleaning over the purge ("poop") bin - engine_cleaningXYMove
+# ---------------------------------------------------------------------
+[gcode_macro CLEAN_NOZZLE]
+description: Purge over the bin and wipe the nozzle (stock routine)
+gcode:
+    {% set c = printer["gcode_macro _DP200"] %}
+    _SINDOH_ENSURE_HOMED
+    SAVE_GCODE_STATE NAME=clean_nozzle
+    G90
+    G1 Z{c.clean_z} F600
+    G1 Y{c.clean_y} F6000
+    G1 X{c.clean_x1} F6000
+    _SINDOH_TEMP {rawparams}
+    {% if params.PURGE|default(1)|int %}
+        M83
+        G1 E{c.clean_purge} F{c.clean_purge_speed * 60}
+        G1 E-{c.clean_retract} F{c.clean_retract_speed * 60}
+        G4 P{c.clean_delay * 1000}
+        _SINDOH_BIN_COUNT
+    {% endif %}
+    {% for i in range(c.clean_wipes) %}
+        G1 X{c.clean_x2} F{c.clean_wipe_speed * 60}
+        G1 X{c.clean_x1} F{c.clean_wipe_speed * 60}
+    {% endfor %}
+    RESTORE_GCODE_STATE NAME=clean_nozzle
+
+[gcode_macro _SINDOH_BIN_COUNT]
+gcode:
+    {% set c = printer["gcode_macro _DP200"] %}
+    {% set n = printer.save_variables.variables.bin_count|default(0)|int + 1 %}
+    SAVE_VARIABLE VARIABLE=bin_count VALUE={n}
+    {% if n >= c.bin_threshold %}
+        M118 Purge bin has {n} purges - please empty it, then run BIN_EMPTIED
+    {% endif %}
+
+[gcode_macro BIN_EMPTIED]
+description: Reset the purge bin counter
+gcode:
+    SAVE_VARIABLE VARIABLE=bin_count VALUE=0
+    M118 Purge bin counter reset
+
+# ---------------------------------------------------------------------
+# UNLOAD - stock engine_filaUnload + FM cmd 0x13
+#   Open filament: no reliable presence sensor, so it retracts the measured
+#   path length (inlet_to_nozzle + unload_extra). Park, heat, clutch on,
+#   first 50 mm at 10 mm/s, the rest at 25 mm/s, clutch off. The encoder
+#   is disabled meanwhile (the filament leaves its wheel before the end).
+# ---------------------------------------------------------------------
+[gcode_macro UNLOAD_FILAMENT]
+description: Unload filament out of the feeder (stock speeds, measured length). MATERIAL=PLA|ABS or TEMP=
+gcode:
+    {% set c = printer["gcode_macro _DP200"] %}
+    {% set rest = c.inlet_to_nozzle + c.unload_extra - c.unload_slow %}
+    {% set n = (rest / c.e_chunk)|round(0, 'ceil')|int %}
+    _SINDOH_ENSURE_HOMED
+    {% if params.CLEAN|default(0)|int %}
+        CLEAN_NOZZLE PURGE=0 {rawparams}
+    {% endif %}
+    G90
+    G1 Z{c.park_z} F600
+    G1 X{c.park_x} Y{c.park_y} F6000
+    _SINDOH_TEMP {rawparams}
+    SET_FILAMENT_SENSOR SENSOR=filament_encoder ENABLE=0
+    SET_PIN PIN=clutch VALUE=1
+    M83
+    G1 E-{c.unload_slow} F{c.unload_slow_speed * 60}
+    {% for i in range(n) %}
+        G1 E-{rest / n} F{c.unload_fast_speed * 60}
+    {% endfor %}
+    M400
+    SET_PIN PIN=clutch VALUE=0
+    SET_FILAMENT_SENSOR SENSOR=filament_encoder ENABLE=1
+    M118 Unload complete ({c.unload_slow + rest} mm) - pull the filament out of the inlet
+
+# ---------------------------------------------------------------------
+# LOAD - stock engine_filaLoad + FM cmds 0x0f, 0x10, 0x11, open filament
+#   Push the filament into the inlet until the feeder gears grab it, then
+#   run LOAD_FILAMENT. Over the purge bin: heat (Klipper refuses cold
+#   extrusion), clutch on, fast feed load_fast at 40 mm/s (stops ~78 mm
+#   short), then the rest of the path + the stock 42.5 mm purge at 3 mm/s,
+#   wait 1 s, retract 15 mm at 40 mm/s, clutch off, wait 3 s, wipe.
+# ---------------------------------------------------------------------
+[gcode_macro LOAD_FILAMENT]
+description: Load open filament from the inlet, purge over the bin and wipe. MATERIAL=PLA|ABS or TEMP=
+gcode:
+    {% set c = printer["gcode_macro _DP200"] %}
+    {% set n = (c.load_fast / c.e_chunk)|round(0, 'ceil')|int %}
+    {% set slow = c.inlet_to_nozzle - c.load_fast + c.load_purge %}
+    {% set m = (slow / c.e_chunk)|round(0, 'ceil')|int %}
+    _SINDOH_ENSURE_HOMED
+    G90
+    G1 Z{c.clean_z} F600
+    G1 Y{c.clean_y} F6000
+    G1 X{c.clean_x1} F6000
+    _SINDOH_TEMP {rawparams}
+    SET_FILAMENT_SENSOR SENSOR=filament_encoder ENABLE=0
+    SET_PIN PIN=clutch VALUE=1
+    M83
+    {% for i in range(n) %}
+        G1 E{c.load_fast / n} F{c.load_feed_speed * 60}
+    {% endfor %}
+    {% for i in range(m) %}
+        G1 E{slow / m} F{c.load_purge_speed * 60}
+    {% endfor %}
+    G4 P{(c.load_dwell * 1000)|int}
+    G1 E-{c.load_retract} F{c.load_retract_speed * 60}
+    M400
+    SET_PIN PIN=clutch VALUE=0
+    G4 P{c.load_settle * 1000}
+    _SINDOH_BIN_COUNT
+    CLEAN_NOZZLE PURGE=0 {rawparams}
+    SET_FILAMENT_SENSOR SENSOR=filament_encoder ENABLE=1
+    M118 Load complete
+
+
+# ---------------------------------------------------------------------
+# LV bed-levelling probe, used like a BL-touch (PROBE, BED_MESH_CALIBRATE)
+#   State: dec_sensor +0x210 bit 8 (pin dsens8): 0 = pin extended
+#   (deployed), 1 = pushed in (stowed, or pushed by the bed while probing).
+#   It is a push-push latch toggled by driving the X carriage into a lever at
+#   the left wall (stock engine_changelvsensor: X -> -10, push to -20 at
+#   10 mm/s, back to -5.6; up to 3 tries). Verified on hardware 2026-10-18:
+#   triggers ~1.28 mm before the Z-switch height, the bed push does NOT
+#   latch it (stays deployed for a whole session), repeat 0.0006 mm.
+#
+#   Klipper runs [probe] activate_gcode after the move to each point and
+#   forbids toolhead moves in it, so the wall toggle cannot go there.
+#   Instead (like docked probes) the probing commands are wrapped:
+#   deploy -> base command -> stow. A stowed pin reads "triggered", so
+#   Klipper itself refuses to probe with it ("Probe triggered prior to
+#   movement") - the nozzle can never be driven into the bed that way.
+# ---------------------------------------------------------------------
+[gcode_macro LV_TOGGLE]
+description: Toggle the latching levelling probe via the X-carriage lever
+gcode:
+    {% if 'x' not in printer.toolhead.homed_axes %}
+        {action_raise_error("LV_TOGGLE: home X first (G28 X)")}
+    {% endif %}
+    SAVE_GCODE_STATE NAME=lv_toggle
+    G90
+    {% if 'z' in printer.toolhead.homed_axes and printer.toolhead.position.z < 10 %}
+        G1 Z10 F600
+    {% endif %}
+    G1 X-10 F6000
+    G1 X-20 F600
+    G1 X-5.6 F6000
+    M400
+    RESTORE_GCODE_STATE NAME=lv_toggle
+
+[probe]
+pin: dsens8
+# x_offset / y_offset / z_offset: per printer -> printer.cfg
+# (z_offset is saved by LV_PROBE_CALIBRATE_SAVE + SAVE_CONFIG)
+speed: 2
+lift_speed: 5
+samples: 2
+samples_result: median
+sample_retract_dist: 2.0
+samples_tolerance: 0.1
+samples_tolerance_retries: 2
+
+[bed_mesh]
+speed: 80
+horizontal_move_z: 10      # the pin hangs below the nozzle: keep travel high
+# Probe coordinates. The pin reaches X -6..248 and Y -32..171 (nozzle travel
+# + offsets). The front edge of the bed has a full-width grip handle: keep
+# mesh_min Y well behind it (30 until the handle depth is known).
+mesh_min: 20, 30
+mesh_max: 190, 170
+probe_count: 5, 5
+algorithm: bicubic
+fade_start: 1
+fade_end: 10
+
+# Z homing uses the top switch, which the bed reaches ~1.3 mm after it
+# would hit a deployed pin: always stow the pin before homing Z.
+[force_move]
+enable_force_move: True
+
+[homing_override]
+axes: xyz
+gcode:
+    {% set all = 'X' not in params and 'Y' not in params and 'Z' not in params %}
+    {% if all or 'X' in params %}
+        G28 X
+    {% endif %}
+    {% if all or 'Y' in params %}
+        G28 Y
+    {% endif %}
+    {% if all or 'Z' in params %}
+        QUERY_PROBE
+        _SINDOH_HOME_Z
+    {% endif %}
+
+[gcode_macro _SINDOH_HOME_Z]
+gcode:
+    {% if not printer.probe.last_query %}
+        M118 Probe pin is deployed - stowing it before Z homing
+        {% if 'x' not in printer.toolhead.homed_axes %}
+            G28 X
+        {% endif %}
+        {% if 'z' not in printer.toolhead.homed_axes %}
+            # bed height unknown: move it 10 mm down blind (at the bottom it just stalls)
+            FORCE_MOVE STEPPER=stepper_z DISTANCE=10 VELOCITY=5
+        {% endif %}
+        LV_STOW
+    {% endif %}
+    G28 Z
+
+[gcode_macro LV_DEPLOY]
+description: Make sure the levelling probe pin is extended (push-push latch)
+gcode:
+    QUERY_PROBE
+    _LV_TRY1 WANT=0
+
+[gcode_macro LV_STOW]
+description: Make sure the levelling probe pin is retracted
+gcode:
+    QUERY_PROBE
+    _LV_TRY1 WANT=1
+
+# Klipper forbids recursive macros, so the stock "up to 3 tries" is unrolled.
+# Each step is rendered only when it runs, i.e. after the previous QUERY_PROBE.
+[gcode_macro _LV_TRY1]
+gcode:
+    {% if (1 if printer.probe.last_query else 0) != params.WANT|int %}
+        LV_TOGGLE
+        QUERY_PROBE
+        _LV_TRY2 WANT={params.WANT}
+    {% endif %}
+
+[gcode_macro _LV_TRY2]
+gcode:
+    {% if (1 if printer.probe.last_query else 0) != params.WANT|int %}
+        LV_TOGGLE
+        QUERY_PROBE
+        _LV_TRY3 WANT={params.WANT}
+    {% endif %}
+
+[gcode_macro _LV_TRY3]
+gcode:
+    {% if (1 if printer.probe.last_query else 0) != params.WANT|int %}
+        LV_TOGGLE
+        QUERY_PROBE
+        _LV_FINAL WANT={params.WANT}
+    {% endif %}
+
+[gcode_macro _LV_FINAL]
+gcode:
+    {% if (1 if printer.probe.last_query else 0) != params.WANT|int %}
+        {action_raise_error("Levelling probe did not toggle after 3 tries (stock error 0x137)")}
+    {% endif %}
+
+# ---- probing commands wrapped with deploy/stow
+# Guard: on 2026-10-18 some runs read ~1.1-1.5 mm higher than others at the
+# same spot, once switching in the middle of a mesh (cause not found; not
+# reproduced since - see hardware_notes). The wrapper probes a reference
+# point before and after the mesh with the same deploy and discards the mesh
+# if they disagree by more than variable_ref_tol.
+[gcode_macro BED_MESH_CALIBRATE]
+rename_existing: _BED_MESH_CALIBRATE_BASE
+description: Deploy the LV probe, build a bed mesh (with a stability check), stow the probe
+variable_ref_x: 95
+variable_ref_y: 100
+variable_ref_tol: 0.1
+variable_ref_before: 0.0
+gcode:
+    _SINDOH_ENSURE_HOMED
+    G90
+    G1 Z10 F300
+    LV_DEPLOY
+    _SINDOH_MESH_REF
+    _SINDOH_MESH_REF_SAVE
+    _BED_MESH_CALIBRATE_BASE {rawparams}
+    _SINDOH_MESH_REF
+    _SINDOH_MESH_CHECK
+    LV_STOW
+
+[gcode_macro _SINDOH_MESH_REF]
+gcode:
+    {% set m = printer["gcode_macro BED_MESH_CALIBRATE"] %}
+    {% set off = printer.configfile.settings.probe %}
+    G1 Z10 F300
+    G1 X{m.ref_x - off.x_offset} Y{m.ref_y - off.y_offset} F6000
+    _PROBE_BASE SAMPLES=1
+    G1 Z10 F300
+
+# (templates render before they run: values read after a probe and errors
+# raised after cleanup need their own macros)
+[gcode_macro _SINDOH_MESH_REF_SAVE]
+gcode:
+    SET_GCODE_VARIABLE MACRO=BED_MESH_CALIBRATE VARIABLE=ref_before VALUE={printer.probe.last_z_result}
+
+[gcode_macro _SINDOH_MESH_CHECK]
+gcode:
+    {% set m = printer["gcode_macro BED_MESH_CALIBRATE"] %}
+    {% set after = printer.probe.last_z_result|float %}
+    {% set d = after - m.ref_before|float %}
+    {% if d|abs > m.ref_tol %}
+        BED_MESH_CLEAR
+        LV_STOW
+        _SINDOH_MESH_FAIL D={"%.3f" % d} A={"%.3f" % m.ref_before|float} B={"%.3f" % after}
+    {% else %}
+        M118 Mesh reference check OK ({"%.3f" % d} mm)
+    {% endif %}
+
+[gcode_macro _SINDOH_MESH_FAIL]
+gcode:
+    {action_raise_error("Mesh discarded: reference probe moved %s mm during the mesh (%s -> %s). Probe pin unstable - run it again." % (params.D, params.A, params.B))}
+
+[gcode_macro PROBE]
+rename_existing: _PROBE_BASE
+description: Deploy the LV probe, probe at the current XY, stow it
+gcode:
+    _SINDOH_ENSURE_HOMED
+    _SINDOH_PROBE_AT CMD=_PROBE_BASE {rawparams}
+
+[gcode_macro PROBE_ACCURACY]
+rename_existing: _PROBE_ACCURACY_BASE
+description: Deploy the LV probe, run PROBE_ACCURACY at the current XY, stow it
+gcode:
+    _SINDOH_ENSURE_HOMED
+    _SINDOH_PROBE_AT CMD=_PROBE_ACCURACY_BASE {rawparams}
+
+# Deploy at the wall, come back to the starting XY at Z >= 10 (never lower
+# with the pin out), run the base command there, stow.
+[gcode_macro _SINDOH_PROBE_AT]
+gcode:
+    {% set x = printer.toolhead.position.x %}
+    {% set y = printer.toolhead.position.y %}
+    {% set z = [printer.toolhead.position.z, 10]|max %}
+    {% set pass = rawparams.split(' ')[1:]|join(' ') %}
+    SAVE_GCODE_STATE NAME=dp200_probe_at
+    G90
+    G1 Z{z} F600
+    LV_DEPLOY
+    G1 X{x} Y{y} F6000
+    {params.CMD} {pass}
+    G1 Z{z} F600
+    LV_STOW
+    RESTORE_GCODE_STATE NAME=dp200_probe_at
+
+# ---- z_offset calibration. Klipper's PROBE_CALIBRATE would lower the nozzle
+# for the paper test with the pin still deployed below it, so:
+#   1. LV_PROBE_CALIBRATE [X=110 Y=100]: probes the point with the pin,
+#      stows it, puts the NOZZLE over the same point and starts a manual probe
+#   2. paper test with TESTZ Z=-0.1 ... then ACCEPT
+#   3. LV_PROBE_CALIBRATE_SAVE, then SAVE_CONFIG
+[gcode_macro LV_PROBE_CALIBRATE]
+description: Probe a point with the LV pin, then paper-test the nozzle there (step 1 of 3)
+gcode:
+    {% set x = params.X|default(110)|float %}
+    {% set y = params.Y|default(100)|float %}
+    {% set off = printer.configfile.settings.probe %}
+    _SINDOH_ENSURE_HOMED
+    G90
+    G1 Z10 F600
+    LV_DEPLOY
+    G1 X{x - off.x_offset} Y{y - off.y_offset} F6000
+    _PROBE_BASE
+    G1 Z10 F600
+    LV_STOW
+    G1 X{x} Y{y} F6000
+    G1 Z5 F600
+    M118 Paper test: TESTZ Z=-0.1 (repeat) until the paper drags, then ACCEPT, then LV_PROBE_CALIBRATE_SAVE
+    MANUAL_PROBE
+
+[gcode_macro LV_PROBE_CALIBRATE_SAVE]
+description: Compute probe z_offset from the last PROBE and the paper test (step 3 of 3). Z=<the "Z position is ..." value printed by ACCEPT>
+gcode:
+    # Klipper clears manual_probe.z_position after ACCEPT, so the accepted
+    # value is passed in: LV_PROBE_CALIBRATE_SAVE Z=0.825
+    {% set trig = printer.probe.last_z_result|float %}
+    {% if params.Z is not defined %}
+        {action_raise_error("Pass the accepted paper-test height: LV_PROBE_CALIBRATE_SAVE Z=<value from 'Z position is ...'>")}
+    {% endif %}
+    {% set zero = params.Z|float %}
+    {% set old = printer.configfile.settings.probe.z_offset|float %}
+    {% set new = trig - zero|float %}
+    M118 probe trigger z={trig} nozzle zero z={zero} -> z_offset={new}
+    SET_GCODE_OFFSET Z={old - new}
+    Z_OFFSET_APPLY_PROBE
+    SET_GCODE_OFFSET Z=0
+    M118 Run SAVE_CONFIG to store z_offset={new}
diff --git a/config/sindoh-dp200/dp200_printer.cfg b/config/sindoh-dp200/dp200_printer.cfg
