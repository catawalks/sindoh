index 00000000..f8e0486f
--- /dev/null
+++ b/config/sindoh-dp200/dp200_printer.cfg
@@ -0,0 +1,417 @@
+# Sindoh DP200 hardware definition - included by printer.cfg.
+# This file is replaced on updates: put your own changes in printer.cfg.
+# Options that calibration commands save (Z position_endstop, probe
+# z_offset, PID gains) are NOT in here: SAVE_CONFIG refuses to override
+# options that come from an included file, so they live in printer.cfg.
+
+# M118 / RESPOND messages (used by the macros)
+[respond]
+
+# Step-engine diagnostics (klipper/extras/upc_stats.py -> klippy/extras/):
+# UPC_STEP_STATS reports pulses and pulses requested while the engine was busy.
+[upc_stats]
+
+# Re-checks the MCU clock 30 s after start-up and withdraws Klipper's spurious
+# "configured for 396Mhz but running at 38xMhz" warning when the settled
+# estimate is fine (klipper/extras/upc_clockcheck.py -> klippy/extras/).
+[upc_clockcheck]
+
+# =====================================================================
+# Sindoh DP200 (Rodin CTL board, Marvell 88PA6170) - Klipper config
+# =====================================================================
+# Two Klipper MCUs run on the SoC's UPC cores (see klipper_port/README.md):
+#   [mcu]     FM core: stepper engines, endstops, motor current
+#   [mcu io]  IO core: heaters, fans, thermistors
+# 'upctool bridge' exposes them as /tmp/klipper_upc_fm and _io.
+#
+# STATUS: first bring-up config. Values come from the stock firmware;
+# items marked TBC must be checked on the machine. Before the first heat
+# test, read the safety section in klipper_port/README.md.
+#
+# Pin names (UPC port):
+#   smot_stepN / smot_dirN / smot_enN  stepper engine N (0=X 1=Y 2=Z 3=E)
+#   xenaN                               XENA input pin N
+#   pwmN                                dec_pwm block N
+#   adcN                                dec_adc input N (0 nozzle, 1 bed)
+# =====================================================================
+
+[mcu]
+serial: /tmp/klipper_upc_fm
+restart_method: command
+
+[mcu io]
+serial: /tmp/klipper_upc_io
+restart_method: command
+
+[printer]
+kinematics: cartesian
+max_velocity: 150             # stock tables top out ~197 mm/s
+max_accel: 1500
+# The UPC step engines take one move per step and lose steps above ~20k
+# steps/s (measured 2026-10-18: Z fine to 19.2k, 1.8 mm lost at 25.6k, 75 % at
+# 32k). Z at 3200 steps/mm -> cap at 5 mm/s (16k). X/Y at 80 steps/mm are fine
+# to 240 mm/s; the extruder (458.83 steps/mm) is capped at 40 mm/s below.
+max_z_velocity: 5
+max_z_accel: 100
+square_corner_velocity: 5.0
+
+# ---------------------------------------------------------------------
+# Steppers: Allegro A4982. Stock scaling X/Y 80, Z 3200, E 458.83 steps/mm.
+# Only full_steps*microsteps/rotation_distance matters (MS1/MS2 unknown).
+# Keep the default step_pulse_duration (2 us): each step is one hardware
+# pulse from the stepper engine, so "step on both edges" must stay off.
+# Direction: the stock engine treats DIR bit = 1 as positive travel.
+# ---------------------------------------------------------------------
+[stepper_x]
+step_pin: smot_step0
+dir_pin: smot_dir0
+enable_pin: !smot_en0          # engine CFG bit0 = 1 disables the driver
+microsteps: 16
+rotation_distance: 40
+endstop_pin: xena42            # X home (XIRD1 bit 10): 1 = triggered (stock homing code; carriage was parked on the switch)
+position_endstop: 216.0        # stock homes X to its MAX end
+position_min: -21.0
+position_max: 233.6            # stock soft limit; purge bin / park positions are 209-231.2 mm
+homing_speed: 10               # stock fine approach ~10.4 mm/s
+second_homing_speed: 5
+homing_positive_dir: true
+
+[stepper_y]
+step_pin: smot_step1
+dir_pin: smot_dir1
+enable_pin: !smot_en1
+microsteps: 16
+rotation_distance: 40
+endstop_pin: xena43            # Y home (XIRD1 bit 11): active-high, measured (0 = free, 1 = triggered)
+position_endstop: 5.5
+position_min: -1.75
+position_max: 201.5
+homing_speed: 10
+second_homing_speed: 5
+
+[stepper_z]
+step_pin: smot_step2
+dir_pin: smot_dir2
+enable_pin: !smot_en2
+microsteps: 16
+rotation_distance: 1
+endstop_pin: xena44            # Z home (XIRD1 bit 12): active-high, at the top (bed up); homing tested
+# position_endstop: per printer -> printer.cfg (paper test / Z_ENDSTOP_CALIBRATE).
+# The switch is at the top of travel, ~2.3 mm above the bed on the first unit.
+position_min: -2.0
+position_max: 194              # ~195 mm bottom-to-switch measured (old coords)
+homing_speed: 5
+second_homing_speed: 2
+
+# ---------------------------------------------------------------------
+# Motor current: A4982 REF from filtered hardware PWM (stock period 200,
+# high = 100 + offset). karas.db offsets X -15, Y +15, Z +30, E +50.
+# ---------------------------------------------------------------------
+[output_pin motor_current_x]
+pin: pwm27
+pwm: True
+hardware_pwm: True
+cycle_time: 0.0001             # ignored by the UPC port (stock period used)
+value: 0.425
+shutdown_value: 0.425
+
+[output_pin motor_current_y]
+pin: pwm29
+pwm: True
+hardware_pwm: True
+cycle_time: 0.0001
+value: 0.60
+shutdown_value: 0.60
+
+[output_pin motor_current_z]
+pin: pwm30
+pwm: True
+hardware_pwm: True
+cycle_time: 0.0001
+value: 0.65
+shutdown_value: 0.65
+
+[output_pin motor_current_e]
+pin: pwm31
+pwm: True
+hardware_pwm: True
+cycle_time: 0.0001
+value: 0.75
+shutdown_value: 0.75
+
+# ---------------------------------------------------------------------
+# Thermistors from the stock lookup tables. The port reports raw 10-bit
+# ADC counts (ADC_MAX 1023), so voltage = raw/1023 with adc_voltage 1.
+# Matches the stock firmware conversion; a reference thermometer check is still advised.
+# ---------------------------------------------------------------------
+# Generated from the stock firmware lookup tables (tools/gen_thermistors.py).
+# Checked on the printer: raw 891 -> 64.1 C (stock 64.6 C), raw 692 bed -> 44.0 C (stock 44.2 C).
+[adc_temperature dp200_nozzle]
+# generated by tools/gen_thermistors.py from adc_temp_mC_lookup_table (stock firmware table)
+temperature1: 0.6
+voltage1: 0.98584
+temperature2: 10.5
+voltage2: 0.97852
+temperature3: 20.1
+voltage3: 0.96875
+temperature4: 30.0
+voltage4: 0.95508
+temperature5: 40.0
+voltage5: 0.93701
+temperature6: 50.1
+voltage6: 0.91357
+temperature7: 60.0
+voltage7: 0.88525
+temperature8: 70.0
+voltage8: 0.85059
+temperature9: 80.1
+voltage9: 0.81006
+temperature10: 90.1
+voltage10: 0.76416
+temperature11: 100.1
+voltage11: 0.71387
+temperature12: 110.1
+voltage12: 0.65967
+temperature13: 120.1
+voltage13: 0.60205
+temperature14: 130.1
+voltage14: 0.54297
+temperature15: 140.1
+voltage15: 0.48438
+temperature16: 150.1
+voltage16: 0.42871
+temperature17: 160.0
+voltage17: 0.37695
+temperature18: 170.0
+voltage18: 0.32910
+temperature19: 180.0
+voltage19: 0.28613
+temperature20: 190.0
+voltage20: 0.24805
+temperature21: 200.1
+voltage21: 0.21436
+temperature22: 210.2
+voltage22: 0.18506
+temperature23: 220.1
+voltage23: 0.16016
+temperature24: 230.1
+voltage24: 0.13867
+temperature25: 240.1
+voltage25: 0.12012
+temperature26: 250.4
+voltage26: 0.10400
+temperature27: 260.1
+voltage27: 0.09082
+temperature28: 270.2
+voltage28: 0.07910
+temperature29: 280.0
+voltage29: 0.06934
+temperature30: 290.4
+voltage30: 0.06055
+
+[adc_temperature dp200_bed]
+# generated by tools/gen_thermistors.py from adc_bed_mC_lookup_table (stock firmware table)
+temperature1: 0.0
+voltage1: 0.92139
+temperature2: 10.1
+voltage2: 0.88330
+temperature3: 20.1
+voltage3: 0.83447
+temperature4: 30.1
+voltage4: 0.77490
+temperature5: 40.0
+voltage5: 0.70654
+temperature6: 50.0
+voltage6: 0.63184
+temperature7: 60.1
+voltage7: 0.55469
+temperature8: 70.0
+voltage8: 0.47949
+temperature9: 80.0
+voltage9: 0.40918
+temperature10: 90.1
+voltage10: 0.34570
+temperature11: 100.0
+voltage11: 0.29053
+temperature12: 110.1
+voltage12: 0.24268
+temperature13: 120.1
+voltage13: 0.20264
+
+[extruder]
+step_pin: smot_step3
+dir_pin: !smot_dir3            # stock: DIR 1 = retract (eject), DIR 0 = feed (insert)
+enable_pin: !smot_en3
+microsteps: 16
+rotation_distance: 6.975       # 200*16/458.83
+nozzle_diameter: 0.400
+filament_diameter: 1.750
+heater_pin: io:pwm5            # dec_pwm block 5, soft PWM (static level)
+max_power: 0.6                 # bring-up limit; raise after PID tuning
+sensor_type: dp200_nozzle
+sensor_pin: io:adc0
+adc_voltage: 1.0
+min_temp: 5                    # stock Err301 below 8 C
+max_temp: 260                  # stock Err304 at 280 C
+min_extrude_temp: 170
+max_extrude_only_distance: 150
+max_extrude_only_velocity: 40  # 18.4k steps/s, under the step-engine limit (~20k)
+# control / pid_Kp / pid_Ki / pid_Kd: per printer -> printer.cfg (PID_CALIBRATE)
+
+[verify_heater extruder]
+max_error: 120
+check_gain_time: 20
+hysteresis: 5
+heating_gain: 2
+
+[heater_bed]
+heater_pin: io:pwm24           # dec_pwm block 0x18
+max_power: 0.6
+sensor_type: dp200_bed
+sensor_pin: io:adc1
+adc_voltage: 1.0
+min_temp: 5
+max_temp: 100                  # stock table ends ~125 C
+# control / pid_Kp / pid_Ki / pid_Kd: per printer -> printer.cfg (PID_CALIBRATE)
+
+[verify_heater heater_bed]
+max_error: 120
+check_gain_time: 90
+hysteresis: 5
+heating_gain: 2
+
+# ---------------------------------------------------------------------
+# Fans (dec_pwm, stock period 100), identified on the printer:
+# block 1 extruder/hotend heatsink fan, 2 part-cooling fan,
+# 4 rear case exhaust fan (mesh filter), 3 nothing connected.
+# ---------------------------------------------------------------------
+[fan]
+pin: io:pwm2
+
+[heater_fan nozzle_fan]
+pin: io:pwm1
+heater: extruder
+heater_temp: 50.0
+
+[fan_generic exhaust_fan]
+pin: io:pwm4                    # rear case fan with filter; SET_FAN_SPEED FAN=exhaust_fan SPEED=1
+
+# Build-area lamp: the stock "pwm_led_extruder" (LED on the print head).
+# Stock main program: pwm_config_construct(6, ...) addresses dec_pwm base
+# (UIO "dec_pwm" = 0xf9304000) + (6+1)*0x100 = block 7 (stock ctrl 0x18,
+# period 100). SetLamp() switches it; the touchscreen "lamp" menu and
+# karas.db Lamp_Setting default it to on. (Block 10 is the beeper.)
+[output_pin lamp]
+pin: io:pwm7
+pwm: True
+cycle_time: 0.0001             # ignored by the UPC port (stock period used)
+value: 1
+shutdown_value: 0
+
+# ---------------------------------------------------------------------
+# Not configured yet (verify wiring first):
+#   clutch: pwm6 (configured in dp200_macros.cfg; NOT the lamp - see [output_pin lamp])
+#   solenoid: pwm8 (stock ctrl 0x2e on / 0x2a off)
+#   filament/level sensor: xena46 (TBC)
+#   front LED: power-management MCU on Linux /dev/ttyS2 (not a UPC pin)
+# ---------------------------------------------------------------------
+
+[virtual_sdcard]
+path: ~/printer_data/gcodes
+
+[display_status]
+
+[pause_resume]
+
+# PAUSE / RESUME / CANCEL_PRINT (needed by Mainsail and by the filament
+# runout sensor). [pause_resume] saves and restores the G-code state,
+# including the move back, so these only add retract, lift and park.
+[gcode_macro PAUSE]
+description: Pause the print - retract, lift and park
+rename_existing: BASE_PAUSE
+variable_retract: 1.0
+variable_lift: 10.0
+gcode:
+    {% if printer.pause_resume.is_paused %}
+        M118 Already paused
+    {% else %}
+        {% set c = printer["gcode_macro _DP200"] %}
+        {% set th = printer.toolhead %}
+        {% set homed = 'x' in th.homed_axes and 'y' in th.homed_axes and 'z' in th.homed_axes %}
+        BASE_PAUSE
+        {% if printer.extruder.can_extrude %}
+            M83
+            G1 E-{retract} F2100
+        {% endif %}
+        {% if homed %}
+            G90
+            G1 Z{[th.position.z + lift, th.axis_maximum.z]|min} F300
+            G1 X{c.park_x} Y{c.park_y} F6000
+        {% endif %}
+    {% endif %}
+
+[gcode_macro RESUME]
+description: Resume the print - un-retract, move back, continue
+rename_existing: BASE_RESUME
+gcode:
+    {% if not printer.pause_resume.is_paused %}
+        M118 Not paused
+    {% else %}
+        {% if printer.extruder.can_extrude %}
+            M83
+            G1 E{printer["gcode_macro PAUSE"].retract} F2100
+        {% endif %}
+        BASE_RESUME {rawparams}
+    {% endif %}
+
+[gcode_macro CANCEL_PRINT]
+description: Cancel the print - heaters and fan off, lift and park
+rename_existing: BASE_CANCEL_PRINT
+gcode:
+    {% set c = printer["gcode_macro _DP200"] %}
+    {% set th = printer.toolhead %}
+    TURN_OFF_HEATERS
+    M106 S0
+    {% if 'x' in th.homed_axes and 'y' in th.homed_axes and 'z' in th.homed_axes %}
+        G90
+        G1 Z{[th.position.z + 10, th.axis_maximum.z]|min} F300
+        G1 X{c.park_x} Y{c.park_y} F6000
+    {% endif %}
+    CLEAR_PAUSE
+    BASE_CANCEL_PRINT
+
+# Slicer start G-code:  PRINT_START BED=[first_layer_bed_temperature] EXTRUDER=[first_layer_temperature]
+# (Cura: BED={material_bed_temperature_layer_0} EXTRUDER={material_print_temperature_layer_0})
+# Fresh 4x4 mesh before every print (user's routine), then purge + wipe
+# over the bin. NOTE: the bed heater is not verified under Klipper yet -
+# test it before the first print.
+[gcode_macro PRINT_START]
+description: Heat, home, 4x4 bed mesh, purge and wipe. BED= EXTRUDER= MESH=4
+gcode:
+    {% set bed = params.BED|default(60)|float %}
+    {% set ext = params.EXTRUDER|default(210)|float %}
+    {% set n = params.MESH|default(4)|int %}
+    CLEAR_PAUSE
+    M140 S{bed}
+    M104 S150                  # warm the nozzle without oozing while probing
+    G28
+    M190 S{bed}
+    BED_MESH_CALIBRATE PROBE_COUNT={n},{n} PROFILE=print
+    CLEAN_NOZZLE TEMP={ext}    # heats, purges into the bin, wipes
+    M109 S{ext}
+    G90
+    M83
+    G92 E0
+
+[gcode_macro PRINT_END]
+description: End of print - retract, heaters/fan off, lift, present the bed
+gcode:
+    {% set th = printer.toolhead %}
+    M83
+    G1 E-2 F2100
+    TURN_OFF_HEATERS
+    M106 S0
+    G90
+    G1 Z{[th.position.z + 10, th.axis_maximum.z]|min} F300
+    G1 X{th.axis_maximum.x - 10} Y{th.axis_maximum.y - 5} F6000
+    M84
diff --git a/config/sindoh-dp200/printer.cfg b/config/sindoh-dp200/printer.cfg
new file mode 100644
index 00000000..99f0a6e0
--- /dev/null
+++ b/config/sindoh-dp200/printer.cfg
@@ -0,0 +1,42 @@
+# =====================================================================
+# Sindoh DP200 - YOUR printer.cfg
+# =====================================================================
+# The hardware definition and the macros come from the two included files,
+# which updates replace. This file is yours and is never overwritten:
+# - put your own changes and overrides here (a section repeated here adds
+#   to / overrides the included one);
+# - the per-printer values below are written by calibration commands, then
+#   SAVE_CONFIG (which only works for options that are NOT in an include).
+# =====================================================================
+
+[include dp200_printer.cfg]
+[include dp200_macros.cfg]
+
+# --- per-printer calibration -----------------------------------------
+[stepper_z]
+# Z switch height above the bed: paper test (LV_PROBE_CALIBRATE) or
+# Z_ENDSTOP_CALIBRATE. First unit (2026-10-19): 2.275.
+position_endstop: 2.275
+
+[probe]
+# Pin position relative to the nozzle (measure with a ruler): the pin sits
+# front-right of the nozzle on the DP200 (front = lower Y).
+x_offset: 15
+y_offset: -30
+# Pin tip below the nozzle: LV_PROBE_CALIBRATE -> paper test -> ACCEPT ->
+# LV_PROBE_CALIBRATE_SAVE Z=<accepted> -> SAVE_CONFIG. First unit: 2.530.
+z_offset: 2.530
+
+[extruder]
+# Placeholder gains - run PID_CALIBRATE HEATER=extruder TARGET=210, then SAVE_CONFIG
+control: pid
+pid_Kp: 22.2
+pid_Ki: 1.08
+pid_Kd: 114
+
+[heater_bed]
+# Placeholder gains - run PID_CALIBRATE HEATER=heater_bed TARGET=60, then SAVE_CONFIG
+control: pid
+pid_Kp: 54.0
+pid_Ki: 0.77
+pid_Kd: 948.0
-- 
