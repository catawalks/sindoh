From a223dabc37713a18d8f1e402bd85535ffec9c9d6 Mon Sep 17 00:00:00 2001
From: catawalks <59056948+catawalks@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:25:31 -0400
Subject: [PATCH 14/14] sindoh-dp200: Wait for the MCU clock to settle before
 homing (UPC_WAIT_CLOCK)

For a few seconds after a Klipper restart the FM clock estimate is ~1 %
off; a print started 1 s after RESTART failed in G28 with 'Timer too
close'. UPC_WAIT_CLOCK waits until every MCU estimate is within 0.3 %;
the homing override calls it first. Tested: 1.2 % off at ready, settled
after 19 s.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 config/sindoh-dp200/dp200_macros.cfg |  3 ++
 klippy/extras/upc_clockcheck.py      | 43 +++++++++++++++++++++++++---
 2 files changed, 42 insertions(+), 4 deletions(-)

diff --git a/config/sindoh-dp200/dp200_macros.cfg b/config/sindoh-dp200/dp200_macros.cfg
index dc5e1305..d501aa3f 100644
--- a/config/sindoh-dp200/dp200_macros.cfg
+++ b/config/sindoh-dp200/dp200_macros.cfg
@@ -348,6 +348,9 @@ enable_force_move: True
 [homing_override]
 axes: xyz
 gcode:
+    # right after a Klipper restart the FM clock estimate is ~1 % off for
+    # a few seconds and homing then fails with "Timer too close"
+    UPC_WAIT_CLOCK
     {% set all = 'X' not in params and 'Y' not in params and 'Z' not in params %}
     {% if all or 'X' in params %}
         _SINDOH_HOME_X
diff --git a/klippy/extras/upc_clockcheck.py b/klippy/extras/upc_clockcheck.py
index 29c6b8c2..70463cd6 100644
--- a/klippy/extras/upc_clockcheck.py
+++ b/klippy/extras/upc_clockcheck.py
@@ -10,6 +10,12 @@
 # after ready and withdraws the warning when the settled estimate agrees.
 # A real frequency problem keeps its warning.
 #
+# While the estimate is still off, MCU commands get scheduled against the
+# wrong clock: a print started 1 s after a RESTART failed in G28 with "MCU
+# shutdown: Timer too close" (2026-10-27). UPC_WAIT_CLOCK [TIMEOUT=60] waits
+# until every MCU's estimate is within 0.3 %; the DP200 homing override
+# calls it first.
+#
 #   [upc_clockcheck]
 #   #settle_time: 30
 #
@@ -22,18 +28,47 @@ class UPCClockCheck:
         self.printer = config.get_printer()
         self.settle = config.getfloat('settle_time', 30., minval=2.)
         self.printer.register_event_handler("klippy:ready", self._ready)
+        gcode = self.printer.lookup_object('gcode')
+        gcode.register_command('UPC_WAIT_CLOCK', self.cmd_UPC_WAIT_CLOCK,
+                               desc=self.cmd_UPC_WAIT_CLOCK_help)
 
     def _ready(self):
         reactor = self.printer.get_reactor()
         reactor.register_timer(self._recheck, reactor.monotonic() + self.settle)
 
-    def _recheck(self, eventtime):
-        pconfig = self.printer.lookup_object('configfile')
+    def _estimates(self, eventtime):
+        # (mcu, configured Hz, currently estimated Hz) for every MCU
         for name, mcu in self.printer.lookup_objects(module='mcu'):
-            mcu_name = mcu.get_name()
             mcu_freq = mcu.seconds_to_clock(1.)
             calc_freq = mcu.estimated_print_time(eventtime + 1.) - mcu.estimated_print_time(eventtime)
-            calc_freq = calc_freq * mcu_freq
+            yield mcu, mcu_freq, calc_freq * mcu_freq
+
+    cmd_UPC_WAIT_CLOCK_help = "Wait until the MCU clock estimates have settled (after a restart)"
+    def cmd_UPC_WAIT_CLOCK(self, gcmd):
+        timeout = gcmd.get_float('TIMEOUT', 60., minval=0.)
+        reactor = self.printer.get_reactor()
+        end = reactor.monotonic() + timeout
+        told = False
+        while True:
+            now = reactor.monotonic()
+            off = max([abs(c - f) / f for m, f, c in self._estimates(now)] or [0.])
+            if off <= 0.003:
+                if told:
+                    gcmd.respond_info("MCU clock settled")
+                return
+            if now > end:
+                raise gcmd.error("MCU clock estimate still %.1f %% off after %.0f s"
+                                 % (off * 100., timeout))
+            if not told:
+                gcmd.respond_info("Waiting for the MCU clock estimate to settle"
+                                  " (%.1f %% off)" % (off * 100.))
+                told = True
+            reactor.pause(now + 1.)
+
+    def _recheck(self, eventtime):
+        pconfig = self.printer.lookup_object('configfile')
+        for mcu, mcu_freq, calc_freq in self._estimates(eventtime):
+            mcu_name = mcu.get_name()
             mhz = int(mcu_freq / 1000000. + 0.5)
             if abs(mcu_freq - calc_freq) > mcu_freq * 0.01:
                 logging.info("upc_clockcheck: MCU '%s' still at %.3f MHz",
