From 0eed04f807354f114f690bd091ea9bb90837ffb3 Mon Sep 17 00:00:00 2001
From: catawalks <59056948+catawalks@users.noreply.github.com>
Date: Wed, 21 Oct 2026 23:05:14 -0400
Subject: [PATCH 5/6] sindoh-dp200: Re-prime in PRINT_START, add PRIME_LINE,
 exclude_object and arcs

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 config/sindoh-dp200/dp200_printer.cfg | 38 +++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/config/sindoh-dp200/dp200_printer.cfg b/config/sindoh-dp200/dp200_printer.cfg
index 1c8e9b26..9533a465 100644
--- a/config/sindoh-dp200/dp200_printer.cfg
+++ b/config/sindoh-dp200/dp200_printer.cfg
@@ -328,6 +328,13 @@ shutdown_value: 0
 [virtual_sdcard]
 path: ~/printer_data/gcodes
 
+# Slicer features: per-object cancel (PrusaSlicer/Orca "label objects:
+# firmware-specific", Mainsail's exclude dialog) and G2/G3 arcs.
+[exclude_object]
+
+[gcode_arcs]
+resolution: 0.5
+
 [display_status]
 
 [pause_resume]
@@ -408,8 +415,39 @@ gcode:
     BED_MESH_CALIBRATE PROBE_COUNT={n},{n} PROFILE=print
     CLEAN_NOZZLE TEMP={ext}    # heats, purges into the bin, wipes
     M109 S{ext}
+    # CLEAN_NOZZLE leaves the filament retracted (clean_retract): push it
+    # back over the bin, let it ooze, wipe once, then leave the bin at Z 10
+    {% set c = printer["gcode_macro _DP200"] %}
+    G90
+    M83
+    G1 Z{c.clean_z} F600
+    G1 X{c.clean_x1} Y{c.clean_y} F6000
+    G1 E{c.clean_retract} F{c.clean_retract_speed * 60}
+    G1 E2 F{c.clean_purge_speed * 60}
+    G4 P1000
+    G1 X{c.clean_x2} F{c.clean_wipe_speed * 60}
+    G1 X{c.clean_x1} F{c.clean_wipe_speed * 60}
+    G1 X{c.clean_x2} F{c.clean_wipe_speed * 60}
+    # Off the bin to the bed centre at Z 10: slicers lower Z before their
+    # first XY move, and Y 5.5 is over the front grip handle
+    G1 X100 Y100 F6000
+    G92 E0
+
+# Prime line along the front of the mesh area (Y 35, clear of the grip
+# handle). Slicer start G-code: PRINT_START ... then PRIME_LINE.
+[gcode_macro PRIME_LINE]
+description: Draw a 120 mm prime line at Y 35, then lift to Z 2
+gcode:
+    {% set epm = 0.0668 %}    # 0.6 mm wide x 0.3 mm high line, 1.75 mm filament
     G90
     M83
+    G1 Z5 F600
+    G1 X40 Y35 F6000
+    G1 Z0.3 F600
+    G1 X160 E{120 * epm} F900
+    G1 Y35.6 F900
+    G1 X120 E{40 * epm} F900
+    G1 Z2 F600
     G92 E0
 
 [gcode_macro PRINT_END]
-- 
