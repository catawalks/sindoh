# HANGTEST=nandsz (docs/kernel/nandboot_hang_analysis.md, hang 25): nandres
# (plain nandboot + hang watchdog + the two no-map areas, no pstore) plus
# 10 KB of incompressible .rodata padding, so that the compressed image is
# as big as the freezing builds' (>= 2,822,352 bytes; every clean two-CPU
# build so far is <= 2,818,460). Tells image size from PSTORE_RAM.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_MV61X0_LAYOUT_PAD=y
CONFIG_MV61X0_PAD_FS_RANDOM=0x2800
