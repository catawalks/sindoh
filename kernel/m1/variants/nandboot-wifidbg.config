# HANGTEST=wifidbg (docs/kernel/wifi_boot_failure.md): nandboot with the
# 88W8782 started the Marvell SDK's way (patch 0013): no winner probe,
# INIT_DONE read for up to 2 s after the download, the replies logged.
# Module parameters switch each step back: mwifiex_usb.usb8782_winner=1,
# mwifiex_usb.usb8782_ready_ms=0. Only the modules matter: they load on
# the mtd0 kernel 5b17e2ec (same config, no module versioning).
CONFIG_MWIFIEX_USB_8782_START=y
