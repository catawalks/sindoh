# HANGTEST=up (docs/kernel/nandboot_hang_analysis.md, test 1): nandboot on
# one CPU, to compare directly with hang 2: maxcpus=1 on the forced command
# line, plus the buddy hard-lockup detector (idle with one CPU online).
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 maxcpus=1"
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
