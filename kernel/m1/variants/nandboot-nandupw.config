# HANGTEST=nandupw (docs/kernel/nandboot_hang_analysis.md, hang 25 rerun):
# nandwdt (plain nandboot + hang watchdog) with maxcpus=1: the single-CPU
# workaround on the plain kernel, for a long NAND-root soak from mtd0.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30 maxcpus=1"
