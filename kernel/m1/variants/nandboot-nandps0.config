# HANGTEST=nandps0 (docs/kernel/nandboot_hang_analysis.md, hang 23): nandram's
# config (nandwdt + PSTORE, PSTORE_RAM, CONSOLE, PMSG) with the ramoops DT
# node's compatible deleted (nandboot-nandps0.dts): the areas stay reserved,
# pstore's core is built in, but no ramoops backend probes or maps anything.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
