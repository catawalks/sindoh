# HANGTEST=nandres (docs/kernel/nandboot_hang_analysis.md, hang 18, split a):
# nandwdt (plain nandboot + hang watchdog) with nanddbg's two no-map 1 MB
# areas at 0x1e000000 reserved, but no PSTORE: nothing maps or writes them.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
