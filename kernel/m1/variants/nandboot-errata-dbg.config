# HANGTEST=errata-dbg (docs/kernel/nandboot_hang_analysis.md): the -errata
# image plus evidence across a reset. DEBUG IMAGE ONLY: it arms a hardware
# watchdog, so each run needs the owner's OK.
# - timer_mv61x0.hang_wdt=30: timer 0 resets the board 30 s after the last
#   kick (a kworker kicks every 5 s), so a hard hang reboots by itself;
# - pstore/ramoops in 1 MB at 0x1e000000 (nandboot-errata-dbg.dts): the
#   kernel log of the boot before, if RAM survives the warm reset.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_PJ4B_MV61X0_CACHE_WRAP=y
CONFIG_PJ4B_ERRATA_6011=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
