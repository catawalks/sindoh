# HANGTEST=wifitrace (docs/kernel/wifi_boot_failure.md): as wifidbg (patch
# 0013, the 8782 started the Marvell SDK's way) plus patch 0014's trace of
# the first command/event transfers and its two experiments
# (mwifiex_usb.usb8782_clear_halt=1, mwifiex_usb.usb8782_cmd_delay_ms=N).
# Both patches build under the same option, so wifidbg rebuilt today would
# carry the trace too; this name keeps the tested wifidbg tar apart. Only
# the modules matter: they load on the mtd0 kernel 5b17e2ec.
CONFIG_MWIFIEX_USB_8782_START=y
