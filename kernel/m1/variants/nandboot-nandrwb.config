# HANGTEST=nandrwb (docs/kernel/nandboot_hang_analysis.md, hang 18): nandram
# (nandwdt + ramoops/pstore and nanddbg's two no-map 1 MB areas) with
# ramoops mem-type = 2 (nandboot-nandrwb.dts): its area is vmap'ed
# cacheable (PAGE_KERNEL) instead of write-combine (Normal
# non-cacheable, the default).
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
