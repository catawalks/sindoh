# HANGTEST=nandram (docs/kernel/nandboot_hang_analysis.md, hang 16 add-back
# step 1): nandwdt (plain nandboot + hang watchdog) plus ramoops/pstore and
# the reserved areas of nanddbg (1 MB ramoops at 0x1e000000, 1 MB NAND-trace
# area at 0x1e100000, both no-map). The trace itself stays off (no
# marvell_nand.trace_phys), so there is no sampler and no tick check either.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
