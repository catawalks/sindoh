# NAND, read-only (patch 0006): marvell_nand on the PXA3xx-style controller,
# every write, erase and mark-bad path refused (CONFIG_MTD_RAW_NAND_READ_ONLY),
# partitions read-only, no UBI, no mtdblock. /dev/mtdN (mtdchar) for reads.
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_MARVELL=y
CONFIG_MTD_RAW_NAND_READ_ONLY=y
# CONFIG_MTD_BLOCK is not set
# CONFIG_MTD_UBI is not set
