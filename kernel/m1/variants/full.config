# "full": the proven pieces together, towards booting the Debian root
# (docs/mainline_userspace.md). SMP (Wi-Fi needs it), SD + ext4, the UPC
# driver, GPIO read-only, I2C bus 2, the RTC read-only, evdev, USB CDC-ACM.
# Built, not booted yet. UBI/UBIFS come later.
# SD (variants/sd.config)
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MV61X0=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# UPC (variants/upc.config)
CONFIG_MV61X0_UPC=y
CONFIG_UNIX98_PTYS=y
CONFIG_MAGIC_SYSRQ=y
# GPIO, read-only in full.dts (variants/gpio.config)
CONFIG_GPIOLIB=y
CONFIG_GPIO_MV61X0=y
CONFIG_GPIO_SYSFS=y
# I2C bus 2 (variants/i2c.config); no touchscreen driver until the touch
# reset line is approved (initramfs/i2c/touch-pins.sh.proposed)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
# RTC, read-only
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MV61X0=y
# input events (touch later), USB serial for CDC-ACM sensors
CONFIG_INPUT_EVDEV=y
CONFIG_USB_ACM=y
# NAND read-only (variants/nand.config, patch 0006) + UBI/UBIFS read-only
# (variants/ubi.config); nand_controller enabled in full.dts
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_MARVELL=y
CONFIG_MTD_RAW_NAND_READ_ONLY=y
# CONFIG_MTD_BLOCK is not set
CONFIG_MTD_UBI=y
# CONFIG_MTD_UBI_FASTMAP is not set
CONFIG_MISC_FILESYSTEMS=y
CONFIG_UBIFS_FS=y
