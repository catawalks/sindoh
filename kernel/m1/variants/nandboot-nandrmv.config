# HANGTEST=nandrmv (docs/kernel/nandboot_hang_analysis.md, hang 18): nandram
# (nandwdt + ramoops/pstore and nanddbg's two no-map 1 MB areas) with
# both areas moved to 0x10000000 (nandboot-nandrmv.dts), ramoops otherwise
# as nandram (write-combine, console on). Tells whether the accelerator
# follows the physical range 0x1e000000 or ramoops itself.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
