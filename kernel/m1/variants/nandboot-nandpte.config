# HANGTEST=nandpte (docs/kernel/nandboot_hang_analysis.md, hang 11): nandtick
# (tick check, PC samples, NAND trace, ramoops, hang watchdog) plus
# CONFIG_PJ4B_MV61X0_PTE_CLEAN (patch 0019): page-table writes are cleaned
# to memory on SMP too (set_pte_ext, dcache_clean_area, flush_pmd_entry),
# as the vendor 3.2 kernel does.
# DEBUG IMAGE ONLY: it arms a hardware watchdog, so each run needs the
# owner's OK.
# - timer_mv61x0.hang_wdt=30: timer 0 resets the board 30 s after the last
#   kick (a kworker kicks every 5 s), so a hard hang reboots by itself;
# - pstore/ramoops in 1 MB at 0x1e000000: the console log of the boot
#   before;
# - marvell_nand.trace_phys=0x1e100000 (patch 0015): the last 126 NAND
#   controller steps in a 4 KB no-map area, printed by the next boot of
#   this image (nandboot-nanddbg.dts reserves both areas).
# Both only help if this same image boots after the reset (mtd0, or a RAM
# boot from U-Boot before the stock autoboot).
CONFIG_CMDLINE="console=ttyS0,115200n8 marvell_nand.write_window=1741,4091 panic=10 consoleblank=0 timer_mv61x0.hang_wdt=30 marvell_nand.trace_phys=0x1e100000 timer_mv61x0.tick_check=100"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PJ4B_MV61X0_PTE_CLEAN=y
