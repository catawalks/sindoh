 static int marvell_nand_hw_ecc_controller_init(struct mtd_info *mtd,
 					       struct nand_ecc_ctrl *ecc)
 {
@@ -2271,7 +2325,9 @@
 	}
 
 	if (!to_marvell_nand(chip)->layout ||
-	    (!nfc->caps->is_nfcv2 && ecc->strength > 1)) {
+	    (!nfc->caps->is_nfcv2 && ecc->strength > 1 &&
+	     !(nfc->caps->bch_v1 && l->writesize == 2048 &&
+	       l->strength == 4 && l->nchunks == 1))) {
 		dev_err(nfc->dev,
 			"ECC strength %d at page size %d is not supported\n",
 			ecc->strength, mtd->writesize);
@@ -2292,7 +2348,27 @@
 	ecc->steps = l->nchunks;
 	ecc->size = l->data_bytes;
 
-	if (ecc->strength == 1) {
+	if (nfc->caps->bch_v1 && ecc->strength == 4) {
+		/*
+		 * 88PA6170: the BCH engine (NDECCCTRL_BCH_EN) with the
+		 * one-chunk 2048 B layout (32 spare + 30 ECC bytes). A page is
+		 * read the way the vendor driver does: one monolithic command,
+		 * three NDCB0 words, 2048 + 32 bytes with ECC on (+ 30 raw).
+		 * That is the Hamming helpers' transfer. The BCH chunk helpers
+		 * would need LEN_OVRD, which this controller does not have.
+		 * Read-only: the write hooks only return -EROFS.
+		 */
+		chip->ecc.algo = NAND_ECC_ALGO_BCH;
+		ecc->strength = 16;
+		ecc->read_page_raw = marvell_nfc_hw_ecc_hmg_read_page_raw;
+		ecc->read_page = marvell_nfc_hw_ecc_hmg_read_page;
+		ecc->read_oob_raw = marvell_nfc_hw_ecc_hmg_read_oob_raw;
+		ecc->read_oob = ecc->read_oob_raw;
+		ecc->write_page_raw = marvell_nfc_ro_write_page;
+		ecc->write_page = marvell_nfc_ro_write_page;
+		ecc->write_oob_raw = marvell_nfc_ro_write_oob;
+		ecc->write_oob = marvell_nfc_ro_write_oob;
+	} else if (ecc->strength == 1) {
 		chip->ecc.algo = NAND_ECC_ALGO_HAMMING;
 		ecc->read_page_raw = marvell_nfc_hw_ecc_hmg_read_page_raw;
 		ecc->read_page = marvell_nfc_hw_ecc_hmg_read_page;
@@ -3113,6 +3189,12 @@
 	.use_dma = true,
 };
 
+static const struct marvell_nfc_caps marvell_88pa6170_nfc_caps = {
+	.max_cs_nb = 2,
+	.max_rb_nb = 1,
+	.bch_v1 = true,
+};
