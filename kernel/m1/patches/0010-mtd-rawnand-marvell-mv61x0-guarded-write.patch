+/*
+ * bch_v1 (88PA6170) program/erase window, in erase blocks of the chip.
+ * Empty by default: nothing is programmed or erased until it is set, e.g.
+ *   echo 4000,4000 > /sys/module/marvell_nand/parameters/write_window
+ * It never reaches outside BCH_V1_FIRST_WRITABLE..(last block - 4): the
+ * stock layout puts U-Boot, the kernel, the U-Boot env, the vendor BBT
+ * partition, the logo, /backup and the factory recovery set (mtd0-mtd5)
+ * below 0xd9a0000, and the vendor BBT (main + mirror + 2 spare blocks) in
+ * the last 4 blocks of the chip.
+ */
+#define BCH_V1_FIRST_WRITABLE	(0xd9a0000 / SZ_128K)	/* mtd6 "filesystem" */
+#define BCH_V1_BBT_BLOCKS	4
+#define BCH_V1_PAGES_PER_BLOCK	64
+
+static int bch_v1_win_first = -1, bch_v1_win_last = -1;
+
+static int bch_v1_win_set(const char *val, const struct kernel_param *kp)
+{
+	int first, last;
+
+	if (sysfs_streq(val, "none") || sysfs_streq(val, "")) {
+		WRITE_ONCE(bch_v1_win_first, -1);
+		WRITE_ONCE(bch_v1_win_last, -1);
+		return 0;
+	}
+	if (sscanf(val, "%d,%d", &first, &last) != 2 || first < 0 ||
+	    last < first)
+		return -EINVAL;
+	WRITE_ONCE(bch_v1_win_first, -1);
+	WRITE_ONCE(bch_v1_win_last, last);
+	WRITE_ONCE(bch_v1_win_first, first);
+	pr_warn("marvell_nand: program/erase window blocks %d-%d\n", first,
+		last);
+	return 0;
+}
+
+static int bch_v1_win_get(char *buf, const struct kernel_param *kp)
+{
+	if (READ_ONCE(bch_v1_win_first) < 0)
+		return sysfs_emit(buf, "none\n");
+	return sysfs_emit(buf, "%d,%d\n", READ_ONCE(bch_v1_win_first),
+			  READ_ONCE(bch_v1_win_last));
+}
+
+static const struct kernel_param_ops bch_v1_win_ops = {
+	.set = bch_v1_win_set,
+	.get = bch_v1_win_get,
+};
+module_param_cb(write_window, &bch_v1_win_ops, NULL, 0644);
+MODULE_PARM_DESC(write_window,
+		 "88PA6170: erase blocks FIRST,LAST that may be programmed or erased (default none)");
+
+/*
+ * May this flash-changing command go out? Only on bch_v1, only a complete
+ * program (SEQIN + 5 address cycles + PAGEPROG) or erase (ERASE1 + 3 row
+ * cycles + ERASE2) in one command, and only on a block inside the window
+ * and the fixed limits. Everything else that can change the flash (page
+ * loads without PAGEPROG, RNDIN, SET_FEATURES, ...) is refused.
+ */
+static bool marvell_nfc_write_allowed(struct nand_chip *chip,
+				      const struct marvell_nfc_op *op)
+{
+	struct marvell_nfc *nfc = to_marvell_nfc(chip->controller);
+	u32 ndcb0 = op->ndcb[0];
+	u8 cmd1 = ndcb0 & 0xff, cmd2 = (ndcb0 >> 8) & 0xff;
+	unsigned int cyc = (ndcb0 >> 16) & 0x7;
+	int first = READ_ONCE(bch_v1_win_first);
+	int last = READ_ONCE(bch_v1_win_last);
+	int nblocks, block;
+	u32 row;
+
+	if (IS_ENABLED(CONFIG_MTD_RAW_NAND_READ_ONLY) || !nfc->caps->bch_v1 ||
+	    nfc->no_write || first < 0 || !(ndcb0 & NDCB0_DBC))
+		return false;
+	if (cmd1 == NAND_CMD_SEQIN && cmd2 == NAND_CMD_PAGEPROG && cyc == 5)
+		row = (op->ndcb[1] >> 16) | ((op->ndcb[2] & 0xff) << 16);
+	else if (cmd1 == NAND_CMD_ERASE1 && cmd2 == NAND_CMD_ERASE2 && cyc == 3)
+		row = op->ndcb[1] & 0xffffff;
+	else
+		return false;
+
+	block = row / BCH_V1_PAGES_PER_BLOCK;
+	nblocks = nanddev_target_size(&chip->base) >> chip->phys_erase_shift;
+	return block >= first && block <= last &&
+	       block >= BCH_V1_FIRST_WRITABLE &&
+	       block < nblocks - BCH_V1_BBT_BLOCKS;
+}
