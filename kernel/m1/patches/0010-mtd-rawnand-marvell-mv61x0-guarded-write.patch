+/*
+ * bch_v1 page program, in the format of the vendor kernel and U-Boot: BCH
+ * on (one 2048 B chunk, the engine adds the 30 ECC bytes), spare bytes
+ * 0-23 as given (0xff from nand_base without OOB data) and "programz" at
+ * 24-31, which both vendor drivers write into every ECC page they program.
+ * Only reaches the flash through the write window (marvell_nfc_send_cmd).
+ */
+static int marvell_nfc_bch_v1_write_page(struct nand_chip *chip, const u8 *buf,
+					 int oob_required, int page)
+{
+	int ret;
+
+	if (IS_ENABLED(CONFIG_MTD_RAW_NAND_READ_ONLY))
+		return -EROFS;
+	memcpy(chip->oob_poi + 24, "programz", 8);
+	marvell_nfc_select_target(chip, chip->cur_cs);
+	marvell_nfc_enable_hw_ecc(chip);
+	ret = marvell_nfc_hw_ecc_hmg_do_write_page(chip, buf, chip->oob_poi,
+						   false, page);
+	marvell_nfc_disable_hw_ecc(chip);
+	return ret;
+}
