+/*
+ * 88PA6170 (bch_v1): the vendor BBT, as the 3.2 driver's bbt_main_descr /
+ * bbt_mirror_descr describe it (and U-Boot uses): 2 bits per block, the
+ * last 4 blocks, "Bbt"/"tbB" at OOB offset 20, version at 23. Read only:
+ * no CREATE or WRITE, so this driver never writes it and new bad blocks
+ * are only kept in RAM.
+ */
+static u8 bch_v1_bbt_pattern[] = { 'B', 'b', 't' };
+static u8 bch_v1_bbt_mirror_pattern[] = { 't', 'b', 'B' };
+
+static struct nand_bbt_descr bch_v1_bbt_main_descr = {
+	.options = NAND_BBT_LASTBLOCK | NAND_BBT_2BIT | NAND_BBT_VERSION |
+		   NAND_BBT_PERCHIP,
+	.offs = 20,
+	.len = 3,
+	.veroffs = 23,
+	.maxblocks = 4,
+	.pattern = bch_v1_bbt_pattern,
+};
+
+static struct nand_bbt_descr bch_v1_bbt_mirror_descr = {
+	.options = NAND_BBT_LASTBLOCK | NAND_BBT_2BIT | NAND_BBT_VERSION |
+		   NAND_BBT_PERCHIP,
+	.offs = 20,
+	.len = 3,
+	.veroffs = 23,
+	.maxblocks = 4,
+	.pattern = bch_v1_bbt_mirror_pattern,
+};
