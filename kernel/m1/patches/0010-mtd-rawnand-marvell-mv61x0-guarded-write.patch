+/*
+ * bch_v1: end of a page program (AUTO_RS). Wait up to 200 ms, the vendor
+ * driver's timeout, for CMDD (done) or BBD (the automatic status read saw
+ * the program fail).
+ */
+static int marvell_nfc_bch_v1_wait_prog(struct nand_chip *chip)
+{
+	struct marvell_nfc *nfc = to_marvell_nfc(chip->controller);
+	u32 cmdd = NDSR_CMDD(to_nand_sel(to_marvell_nand(chip))->ndcb0_csel);
+	u32 bbd = BIT(6);	/* CS0 bad block detect */
+	u32 st;
+	int ret;
+
+	ret = readl_relaxed_poll_timeout(nfc->regs + NDSR, st,
+					 st & (cmdd | bbd), 100, 200000);
+	if (ret) {
+		dev_err(nfc->dev, "program: no CMDD (NDSR 0x%08x)\n", st);
+		return -ETIMEDOUT;
+	}
+	writel_relaxed(st & (cmdd | bbd), nfc->regs + NDSR);
+	if (st & bbd) {
+		dev_err(nfc->dev, "program failed (NDSR 0x%08x)\n", st);
+		return -EIO;
+	}
+	return 0;
+}
