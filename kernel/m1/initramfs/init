#!/bin/sh
# Milestone 1 init. Keep this tiny: PID 1 must never exit, so the checks
# run as a child (/etc/m1-checks.sh) and the shell loop runs regardless.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

sh /etc/m1-checks.sh

while true; do
	setsid cttyhack sh || sh
	sleep 1
done
